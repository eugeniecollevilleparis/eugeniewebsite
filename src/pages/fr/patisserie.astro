---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import BackToTop from "../../components/BackToTop.astro";
import { content } from "../../data/content.js";

const lang = "fr";
const t = content[lang].patisserie;
---

<Layout lang={lang} title={t.meta.title} description={t.meta.description}>
  <Nav lang={lang} />

  <main class="patisserie-page">
    <section class="pp-hero">
      <div class="container pp-hero__inner">
        <a href="/fr" class="pp-back">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M10 4L4 10M4 10H9.5M4 10V4.5" stroke="currentColor" stroke-width="1" />
          </svg>
          <span>{t.back}</span>
        </a>

        <span class="eyebrow" data-reveal>{t.tag}</span>
        <h1 class="display display-2 pp-title" data-reveal style="--reveal-delay:0.1s">
          {t.title} <em>{t.titleEm}</em>
        </h1>
        <div class="pp-rule" data-reveal style="--reveal-delay:0.15s"></div>
        <p class="pp-intro" data-reveal style="--reveal-delay:0.2s">{t.intro}</p>
      </div>
    </section>

    <section class="pp-gallery section">
      <div class="container">
        <div class="pp-grid">
          {t.items.map((item, i) => (
            <figure
              class="pp-item"
              data-reveal
              style={`--reveal-delay:${0.05 + (i % 3) * 0.06}s`}
              data-pf-item
              data-src={item.src}
              data-title={item.title}
              data-category={item.category}
              tabindex="0"
              role="button"
              aria-label={`${item.title} — ${item.category}`}
            >
              <img src={item.src} alt={`${item.title} — ${item.category}`} loading="lazy" />
              <figcaption class="pp-item__caption">
                <span class="pp-item__category">{item.category}</span>
                <span class="pp-item__title">{item.title}</span>
              </figcaption>
            </figure>
          ))}
        </div>

        <div class="pp-cta" data-reveal>
          <a href={t.ctaHref} class="btn btn--solid">{t.cta}</a>
        </div>
      </div>
    </section>

    <div class="lightbox" data-lightbox aria-hidden="true" role="dialog" aria-modal="true">
      <button class="lightbox__close" data-lightbox-close aria-label="Close">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>
      <button class="lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label="Previous">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 6 9 12 15 18"></polyline>
        </svg>
      </button>
      <button class="lightbox__nav lightbox__nav--next" data-lightbox-next aria-label="Next">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 6 15 12 9 18"></polyline>
        </svg>
      </button>
      <figure class="lightbox__figure">
        <img data-lightbox-img alt="" />
        <figcaption class="lightbox__caption">
          <span data-lightbox-category></span>
          <span data-lightbox-title></span>
        </figcaption>
      </figure>
    </div>
  </main>

  <Footer lang={lang} />
  <BackToTop />
</Layout>

<script>
  const items = Array.from(document.querySelectorAll("[data-pf-item]")) as HTMLElement[];
  const lightbox = document.querySelector("[data-lightbox]") as HTMLElement | null;
  const lightboxImg = document.querySelector("[data-lightbox-img]") as HTMLImageElement | null;
  const lightboxTitle = document.querySelector("[data-lightbox-title]") as HTMLElement | null;
  const lightboxCategory = document.querySelector("[data-lightbox-category]") as HTMLElement | null;
  const closeBtn = document.querySelector("[data-lightbox-close]");
  const prevBtn = document.querySelector("[data-lightbox-prev]");
  const nextBtn = document.querySelector("[data-lightbox-next]");
  let currentIndex = 0;
  function show(i: number) {
    if (!lightbox || !lightboxImg || !lightboxTitle || !lightboxCategory || !items.length) return;
    currentIndex = (i + items.length) % items.length;
    const el = items[currentIndex];
    lightboxImg.src = el.getAttribute("data-src") || "";
    lightboxImg.alt = el.getAttribute("data-title") || "";
    lightboxTitle.textContent = el.getAttribute("data-title") || "";
    lightboxCategory.textContent = el.getAttribute("data-category") || "";
    lightbox.classList.add("is-open");
    lightbox.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }
  function close() {
    lightbox?.classList.remove("is-open");
    lightbox?.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }
  items.forEach((el, i) => {
    el.addEventListener("click", () => show(i));
    el.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        show(i);
      }
    });
  });
  closeBtn?.addEventListener("click", close);
  prevBtn?.addEventListener("click", () => show(currentIndex - 1));
  nextBtn?.addEventListener("click", () => show(currentIndex + 1));
  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) close();
  });
  document.addEventListener("keydown", (e) => {
    if (!lightbox?.classList.contains("is-open")) return;
    if (e.key === "Escape") close();
    else if (e.key === "ArrowLeft") show(currentIndex - 1);
    else if (e.key === "ArrowRight") show(currentIndex + 1);
  });
</script>

<style>
  .patisserie-page { background: var(--paper); }
  .pp-hero { padding: clamp(7rem, 14vh, 11rem) var(--gutter) clamp(2rem, 4vh, 3rem); background: var(--paper); }
  .pp-hero__inner { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.2rem; }
  .pp-back { display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-body); font-size: 0.6rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--ink-soft); margin-bottom: 1.5rem; transition: gap 0.4s var(--ease), color 0.4s var(--ease); }
  .pp-back:hover { gap: 0.85rem; color: var(--ink); }
  .pp-title { font-weight: 300; }
  .pp-title em { font-style: italic; font-weight: 300; }
  .pp-rule { width: 4rem; height: 1px; background: var(--accent); margin: 0.75rem 0; }
  .pp-intro { max-width: 52ch; font-size: 0.95rem; line-height: 1.85; color: var(--ink-soft); }
  .pp-gallery { padding-top: clamp(2rem, 4vh, 3rem); }
  .pp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
  .pp-item { position: relative; margin: 0; overflow: hidden; cursor: pointer; aspect-ratio: 4 / 5; background: var(--paper-deep); }
  .pp-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease-out), filter 0.5s var(--ease); }
  .pp-item:hover img, .pp-item:focus-visible img { transform: scale(1.05); filter: brightness(0.92); }
  .pp-item__caption { position: absolute; inset: auto 0 0 0; padding: 1.1rem 1rem; display: flex; flex-direction: column; gap: 0.3rem; color: var(--paper); background: linear-gradient(0deg, rgba(15, 13, 12, 0.78) 0%, rgba(15, 13, 12, 0) 100%); opacity: 0; transform: translateY(0.5rem); transition: opacity 0.5s var(--ease), transform 0.5s var(--ease); pointer-events: none; }
  .pp-item:hover .pp-item__caption, .pp-item:focus-visible .pp-item__caption { opacity: 1; transform: translateY(0); }
  .pp-item__category { font-family: var(--font-body); font-size: 0.55rem; letter-spacing: 0.3em; text-transform: uppercase; opacity: 0.85; }
  .pp-item__title { font-family: var(--font-display); font-style: italic; font-size: 1rem; line-height: 1.2; }
  .pp-cta { margin-top: clamp(3rem, 6vh, 4.5rem); display: flex; justify-content: center; }
  .lightbox { position: fixed; inset: 0; z-index: 200; background: rgba(8, 7, 6, 0.92); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; padding: clamp(1.5rem, 4vw, 4rem); opacity: 0; pointer-events: none; transition: opacity 0.4s var(--ease); }
  .lightbox.is-open { opacity: 1; pointer-events: auto; }
  .lightbox__figure { margin: 0; max-width: min(1200px, 100%); max-height: 100%; display: flex; flex-direction: column; align-items: center; gap: 1.25rem; transform: scale(0.97); transition: transform 0.5s var(--ease-out); }
  .lightbox.is-open .lightbox__figure { transform: scale(1); }
  .lightbox__figure img { max-width: 100%; max-height: 80vh; object-fit: contain; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.4); }
  .lightbox__caption { text-align: center; color: var(--paper); display: flex; flex-direction: column; gap: 0.4rem; }
  .lightbox__caption span:first-child { font-family: var(--font-body); font-size: 0.6rem; letter-spacing: 0.35em; text-transform: uppercase; opacity: 0.6; }
  .lightbox__caption span:last-child { font-family: var(--font-display); font-style: italic; font-size: clamp(1.1rem, 1.5vw, 1.45rem); }
  .lightbox__close, .lightbox__nav { position: absolute; width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgba(245, 241, 234, 0.3); background: transparent; color: var(--paper); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.3s var(--ease), border-color 0.3s var(--ease); }
  .lightbox__close:hover, .lightbox__nav:hover { background: rgba(245, 241, 234, 0.12); border-color: rgba(245, 241, 234, 0.55); }
  .lightbox__close { top: clamp(1rem, 3vh, 2rem); right: clamp(1rem, 3vw, 2rem); }
  .lightbox__nav--prev { left: clamp(1rem, 3vw, 2rem); top: 50%; transform: translateY(-50%); }
  .lightbox__nav--next { right: clamp(1rem, 3vw, 2rem); top: 50%; transform: translateY(-50%); }
  @media (max-width: 900px) { .pp-grid { grid-template-columns: repeat(2, 1fr); } .lightbox__nav { width: 38px; height: 38px; } }
  @media (max-width: 560px) { .pp-grid { grid-template-columns: repeat(2, 1fr); gap: 0.35rem; } .pp-item { aspect-ratio: 1 / 1; } .pp-item__caption { padding: 0.75rem 0.6rem; } .pp-item__title { font-size: 0.85rem; } .pp-item__category { font-size: 0.5rem; } }
</style>
