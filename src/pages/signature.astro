---
import Layout from "../layouts/Layout.astro";

const title = "SIGNATURE — No. 01 · 27 September 2026 · Château Laffitte Carcasset";
const description =
  "Signature No. 01 — 27 September 2026 at Château Laffitte Carcasset, Saint-Estèphe. An evening where architecture, light, sound, gastronomy, conversation and performance are conceived as one.";
---

<Layout lang="en" title={title} description={description}>

  <!-- ===== PASSCODE GATE ===== -->
  <div id="sigGate" class="sig-gate" data-code="carcasset" aria-hidden="false">
    <div class="sig-gate__bg" style="background-image: url('/images/signature/cover.jpg');"></div>
    <div class="sig-gate__inner">
      <p class="sig-gate__brand">SIGNATURE</p>
      <p class="sig-gate__sub">No. 01 &nbsp;·&nbsp; By invitation only</p>
      <form class="sig-gate__form" id="sigGateForm">
        <input type="text" id="sigGateInput" autocomplete="off" placeholder="Access&nbsp;code" aria-label="Access code" autocapitalize="none" autocorrect="off" spellcheck="false">
        <button type="submit">Enter</button>
      </form>
      <p class="sig-gate__err" id="sigGateErr" aria-live="polite"></p>
    </div>
  </div>

  <main class="sig" id="sigMain" hidden>

    <!-- ===== COVER ===== -->
    <section class="sig-page sig-page--cover">
      <div class="sig-page__bg" style="background-image: url('/images/signature/cover.jpg');"></div>
      <div class="sig-page__veil"></div>
      <div class="sig-page__content sig-page__content--center">
        <h1 class="sig-cover__title">SIGNATURE</h1>
        <div class="sig-cover__rule" aria-hidden="true"></div>
        <p class="sig-cover__edition">No. 01</p>
        <p class="sig-cover__date">September&nbsp;2026</p>
      </div>
      <div class="sig-page__footer">
        <span>Château Laffitte Carcasset</span>
        <span class="sep">·</span>
        <span>Saint-Estèphe</span>
      </div>
      <div class="sig-page__num" aria-hidden="true">01</div>
    </section>

    <!-- ===== MANIFESTO ===== -->
    <section class="sig-page sig-page--manifesto">
      <div class="sig-page__bg" style="background-image: url('/images/signature/manifesto.jpg');"></div>
      <div class="sig-page__veil sig-page__veil--soft"></div>
      <div class="sig-page__content sig-page__content--upper">
        <p class="sig-mani__lead" data-reveal>
          We&nbsp;shape&nbsp;environments.<br>
          People&nbsp;shape&nbsp;the&nbsp;experience.
        </p>
        <div class="sig-mani__body" data-reveal style="--reveal-delay:0.2s">
          <p>The places we inhabit influence how we think, behave and connect with one another. Light, sound, architecture, gastronomy, conversation and performance are conceived as one.</p>
          <p>Signature begins with a simple belief: meaningful moments don't happen by accident. They emerge when every element works in harmony.</p>
        </div>
        <p class="sig-mani__close" data-reveal style="--reveal-delay:0.45s">
          <em>What Signature becomes will evolve.<br>The intention will not.</em>
        </p>
      </div>
      <div class="sig-page__num" aria-hidden="true">02</div>
    </section>

    <!-- ===== ACT I ===== -->
    <section class="sig-page sig-page--act">
      <div class="sig-page__bg" style="background-image: url('/images/signature/act1.jpg');"></div>
      <div class="sig-page__veil"></div>
      <div class="sig-page__content sig-page__content--upper">
        <span class="sig-act__label" data-reveal>ACT&nbsp;&nbsp;I.</span>
        <h2 class="sig-act__line" data-reveal style="--reveal-delay:0.15s">
          Every edition begins with a place chosen for what it already possesses.
        </h2>
        <p class="sig-act__under" data-reveal style="--reveal-delay:0.35s">
          <em>Its identity isn't reinvented. It's revealed.</em>
        </p>
      </div>
      <div class="sig-page__num" aria-hidden="true">03</div>
    </section>

    <!-- ===== ACT II ===== -->
    <section class="sig-page sig-page--act">
      <div class="sig-page__bg" style="background-image: url('/images/signature/act2.jpg');"></div>
      <div class="sig-page__veil"></div>
      <div class="sig-page__content sig-page__content--upper">
        <span class="sig-act__label" data-reveal>ACT&nbsp;&nbsp;II.</span>
        <h2 class="sig-act__line" data-reveal style="--reveal-delay:0.15s">
          Every place follows its own rhythm.
        </h2>
        <p class="sig-act__under" data-reveal style="--reveal-delay:0.35s">
          <em>Not everything asks for immediate attention.</em>
        </p>
      </div>
      <div class="sig-page__num" aria-hidden="true">04</div>
    </section>

    <!-- ===== ACT III ===== -->
    <section class="sig-page sig-page--act">
      <div class="sig-page__bg" style="background-image: url('/images/signature/act3.jpg');"></div>
      <div class="sig-page__veil"></div>
      <div class="sig-page__content sig-page__content--upper">
        <span class="sig-act__label" data-reveal>ACT&nbsp;&nbsp;III.</span>
        <h2 class="sig-act__line" data-reveal style="--reveal-delay:0.15s">
          Some conversations deserve a setting.
        </h2>
        <p class="sig-act__under" data-reveal style="--reveal-delay:0.35s">
          <em>The evening begins before a single note is played.</em>
        </p>
      </div>
      <div class="sig-page__num" aria-hidden="true">05</div>
    </section>

    <!-- ===== ACT IV ===== -->
    <section class="sig-page sig-page--act">
      <div class="sig-page__bg" style="background-image: url('/images/signature/act4.jpg');"></div>
      <div class="sig-page__veil"></div>
      <div class="sig-page__content sig-page__content--upper">
        <span class="sig-act__label" data-reveal>ACT&nbsp;&nbsp;IV.</span>
        <h2 class="sig-act__line" data-reveal style="--reveal-delay:0.15s">
          As daylight fades.
        </h2>
        <p class="sig-act__under" data-reveal style="--reveal-delay:0.35s">
          <em>The soundtrack arrives quietly.</em>
        </p>
      </div>
      <div class="sig-page__num" aria-hidden="true">06</div>
    </section>

    <!-- ===== ACT V ===== -->
    <section class="sig-page sig-page--act sig-page--last">
      <div class="sig-page__bg" style="background-image: url('/images/signature/act5.jpg');"></div>
      <div class="sig-page__veil"></div>
      <div class="sig-page__content sig-page__content--upper">
        <span class="sig-act__label" data-reveal>ACT&nbsp;&nbsp;V.</span>
        <h2 class="sig-act__line" data-reveal style="--reveal-delay:0.15s">
          The day finds its own pace.
        </h2>
        <p class="sig-act__under" data-reveal style="--reveal-delay:0.35s">
          <em>Nothing is rushed. Nothing is imposed.</em>
        </p>
      </div>
      <div class="sig-page__num" aria-hidden="true">07</div>
    </section>

    <!-- ===== THE MENU ===== -->
    <section class="sig-menu">
      <div class="sig-menu__bg" style="background-image: url('/images/signature/manifesto.jpg');"></div>
      <div class="sig-menu__veil"></div>

      <div class="sig-menu__inner">

        <header class="sig-menu__head" data-reveal>
          <p class="sig-menu__collab">An evening · By invitation</p>
          <h2 class="sig-menu__title">The&nbsp;Menu</h2>
          <p class="sig-menu__sub"><em>A Médoc Composition</em></p>
          <div class="sig-menu__rule"></div>
        </header>

        <article class="sig-story" data-reveal style="--reveal-delay:0.15s">
          <p class="sig-story__kicker">The story of the dinner</p>
          <h3 class="sig-story__title"><em>Three centuries, one table</em></h3>
          <div class="sig-story__body">
            <p>At the heart of the Médoc, an estate has stood since 1759. Three centuries of vintages, harvests, and corsairs' tales — a terroir, a memory, a quiet legend.</p>
            <p>This dinner has been conceived as a passage through that memory — each course answering to a fragment of the estate's history, paired with the wines it grew.</p>
            <p>One hundred guests, one season. Late September, harvest underway. Cèpes from the Médoc woods, black figs from the South-West, Gironde caviar, oysters from Arcachon Bay, hams and poultry from the Landes, Bazas beef. A cuisine rooted in its place, written for its moment.</p>
            <p>The composition that follows pays tribute to the Bordeaux terroir and to the memory of the estate — from the beef cheek braised in the house wine to the closing tartlet. A vegetarian variation runs in parallel. The gesture remains one: the table as a narrative.</p>
          </div>
        </article>

        <div class="sig-menu__grid">

          <!-- ===== CLASSIC ===== -->
          <div class="sig-menu__col" data-reveal style="--reveal-delay:0.1s">
            <p class="sig-menu__col-kicker">The Composition</p>
            <h3 class="sig-menu__col-title"><em>A Médoc Composition</em></h3>
            <p class="sig-menu__col-note">A passage through the estate, course by course</p>

            <div class="sig-course">
              <p class="sig-course__label">Apéro &nbsp;·&nbsp; Standing Welcome</p>
              <p class="sig-course__wine"><em>Crémant de Bordeaux</em></p>
              <p class="sig-course__dish">Bayonne ham croquettes, Ossau-Iraty béchamel</p>
            </div>

            <div class="sig-course">
              <p class="sig-course__label">Canapé I</p>
              <p class="sig-course__wine"><em>Crémant de Bordeaux</em></p>
              <p class="sig-course__dish">Savoury canelé with South-West confit duck, Ente plum compote</p>
              <p class="sig-course__hint"><em>A second canapé, chosen from the two proposals below.</em></p>
            </div>

            <div class="sig-course">
              <p class="sig-course__label">Canapé II</p>
              <p class="sig-course__dish">Arcachon Bay oyster, mignonette of the estate's red wine and pink shallot, Graves white wine espuma</p>
            </div>

            <div class="sig-course">
              <p class="sig-course__label">Canapé III &nbsp;·&nbsp; In the Chai</p>
              <p class="sig-course__dish">Granita of the estate's partially-fermented grape must, ribot milk, botrytised Sauternes jelly, fresh Périgord walnuts</p>
              <p class="sig-course__hint"><em>Served on a porcelain spoon among the barrels &mdash; a salute to the fermentations underway.</em></p>
            </div>

            <div class="sig-course">
              <p class="sig-course__label">Breads &amp; Butter &nbsp;·&nbsp; At the Table</p>
              <p class="sig-course__dish">Artisan breads from the South-West, house-churned butter with Atlantic seaweed, olive oil</p>
            </div>

            <div class="sig-course">
              <p class="sig-course__label">Starter</p>
              <p class="sig-course__wine"><em>Pessac-Léognan blanc</em></p>
              <p class="sig-course__dish">Meagre from the Gironde estuary, gravlax with lemon verbena and wild fennel, warm Graves white wine beurre blanc, garden pickles (cucumber, fennel, pink shallot, pink radish), watercress, fleur de sel</p>
              <p class="sig-course__hint"><em>Signature cold-to-warm contrast.</em></p>
            </div>

            <div class="sig-course">
              <p class="sig-course__label">Main Course</p>
              <p class="sig-course__wine"><em>Château Laffitte Carcasset, young vintage</em></p>
              <p class="sig-course__dish">Bazas beef cheek braised six hours in the house wine, crushed potato with duck fat, glazed baby carrots, Médoc cèpes confit</p>
            </div>

            <div class="sig-course">
              <p class="sig-course__label">Dessert &mdash; Estate Honey</p>
              <p class="sig-course__wine"><em>Sauternes</em></p>
              <p class="sig-course__dish">Estate honey &mdash; Basque farm-yoghurt siphon with honey and rosemary, flowing gel of South-West black fig, caramelised buckwheat tuile, edible flowers</p>
            </div>

            <div class="sig-course">
              <p class="sig-course__label">Mignardises with Coffee</p>
              <p class="sig-course__dish">Pâte de fruit of the house wine</p>
            </div>

            <div class="sig-course sig-course--signature">
              <p class="sig-course__label">Signature</p>
              <p class="sig-course__dish">Tartlet of single-origin dark chocolate, Gironde caviar, fleur de sel</p>
            </div>
          </div>

          <!-- ===== VEGETARIAN ===== -->
          <div class="sig-menu__col" data-reveal style="--reveal-delay:0.25s">
            <p class="sig-menu__col-kicker">Vegetarian Option</p>
            <h3 class="sig-menu__col-title"><em>Vegetarian Variation</em></h3>
            <p class="sig-menu__col-note">For guests who don't eat meat or fish</p>

            <div class="sig-course">
              <p class="sig-course__label">Apéro &nbsp;·&nbsp; Standing Welcome</p>
              <p class="sig-course__wine"><em>Crémant de Bordeaux</em></p>
              <p class="sig-course__dish">Roasted pumpkin and Ossau-Iraty AOP croquettes, silky béchamel</p>
            </div>

            <div class="sig-course">
              <p class="sig-course__label">Canapé I</p>
              <p class="sig-course__wine"><em>Crémant de Bordeaux</em></p>
              <p class="sig-course__dish">Savoury canelé with stewed Ente plums and confit Bordeaux sweet onion</p>
              <p class="sig-course__hint"><em>A second canapé, chosen from the two proposals below.</em></p>
            </div>

            <div class="sig-course">
              <p class="sig-course__label">Canapé II</p>
              <p class="sig-course__dish">Thin tartlet of Médoc orchard apples, Ossau-Iraty AOP shavings, roasted hazelnut oil, fleur de sel</p>
            </div>

            <div class="sig-course">
              <p class="sig-course__label">Canapé III &nbsp;·&nbsp; In the Chai</p>
              <p class="sig-course__dish">Granita of the estate's partially-fermented grape must, ribot milk, botrytised Sauternes jelly, fresh Périgord walnuts</p>
            </div>

            <div class="sig-course">
              <p class="sig-course__label">Breads &amp; Butter &nbsp;·&nbsp; At the Table</p>
              <p class="sig-course__dish">Artisan breads from the South-West, house-churned butter with Atlantic seaweed, olive oil</p>
            </div>

            <div class="sig-course">
              <p class="sig-course__label">Starter</p>
              <p class="sig-course__wine"><em>Pessac-Léognan blanc</em></p>
              <p class="sig-course__dish">Perfect egg at 64°C with lemon verbena and wild fennel, warm Graves white wine beurre blanc, garden pickles (cucumber, fennel, pink shallot, pink radish), watercress, fleur de sel</p>
            </div>

            <div class="sig-course">
              <p class="sig-course__label">Main Course</p>
              <p class="sig-course__wine"><em>Château Laffitte Carcasset, young vintage</em></p>
              <p class="sig-course__dish">Pithiviers of Médoc cèpes, autumn truffle and Périgord chestnuts, full-bodied vegetable jus with the house wine, celeriac crush with brown butter, glazed vegetables</p>
            </div>

            <div class="sig-course">
              <p class="sig-course__label">Dessert &mdash; Estate Honey</p>
              <p class="sig-course__wine"><em>Sauternes</em></p>
              <p class="sig-course__dish">Estate honey &mdash; Basque farm-yoghurt siphon with honey and rosemary, flowing gel of South-West black fig, caramelised buckwheat tuile, edible flowers</p>
              <p class="sig-course__hint"><em>Set with agar-agar &mdash; strictly vegetarian.</em></p>
            </div>

            <div class="sig-course">
              <p class="sig-course__label">Mignardises with Coffee</p>
              <p class="sig-course__dish">Pâte de fruit of the house wine</p>
            </div>

            <div class="sig-course sig-course--signature">
              <p class="sig-course__label">Signature</p>
              <p class="sig-course__dish">Tartlet of single-origin dark chocolate, fleur de sel, yuzu zest</p>
            </div>
          </div>

        </div>

        <p class="sig-menu__foot" data-reveal>
          <span>A table written for one evening</span>
        </p>

      </div>
    </section>

    <!-- ===== PRACTICAL — CALENDAR / RESERVE / NEWSLETTER ===== -->
    <section class="sig-practical">
      <div class="sig-practical__inner">

        <div class="sig-card" data-reveal>
          <p class="sig-card__eyebrow">Save the date</p>
          <p class="sig-card__title">27 September 2026</p>
          <p class="sig-card__sub">From 6&nbsp;PM until midnight<br>Château Laffitte Carcasset · Saint-Estèphe</p>
          <a class="sig-card__cta" href="/signature.ics" download>Add to calendar</a>
        </div>

        <div class="sig-card" data-reveal style="--reveal-delay:0.15s">
          <p class="sig-card__eyebrow">Reserve your place</p>
          <p class="sig-card__title">Tickets</p>
          <p class="sig-card__sub">By invitation only.<br>An email confirms your reservation.</p>
          <a class="sig-card__cta" href="mailto:eugeniecolleville.paris@gmail.com?subject=Signature%20No.%2001%20%E2%80%94%20Reservation&body=Hello%20Eug%C3%A9nie%2C%0A%0AI%20would%20like%20to%20reserve%20___%20place(s)%20for%20Signature%20No.%2001%20on%2027%20September%202026.%0A%0AName%3A%20%0APhone%3A%20%0ADietary%20notes%3A%20%0A%0AThank%20you.">Reserve by email</a>
        </div>

        <div class="sig-card" data-reveal style="--reveal-delay:0.3s">
          <p class="sig-card__eyebrow">Stay close</p>
          <p class="sig-card__title">Newsletter</p>
          <p class="sig-card__sub">Future editions, private dinners and seasonal menus.</p>
          <form class="sig-news" id="sigNews">
            <input type="email" name="email" required placeholder="your@email.com" aria-label="Your email" autocomplete="email">
            <button type="submit">Subscribe</button>
          </form>
          <p class="sig-news__ok" id="sigNewsOk" hidden>Thank you. An email opened — just press send.</p>
        </div>

      </div>
    </section>

    <!-- ===== COLOPHON ===== -->
    <section class="sig-end">
      <div class="sig-end__inner" data-reveal>
        <div class="sig-end__mark">·</div>
        <p class="sig-end__line">SIGNATURE</p>
        <p class="sig-end__small">No. 01 &nbsp;·&nbsp; 27 September 2026</p>
        <p class="sig-end__venue"><em>Château Laffitte Carcasset</em> · Saint-Estèphe · Bordeaux</p>
        <p class="sig-end__contact">For invitations and conversation&nbsp;: <a href="mailto:eugeniecolleville.paris@gmail.com">eugeniecolleville.paris@gmail.com</a></p>
      </div>
    </section>

  </main>
</Layout>

<style>
  :root {
    --sig-ink: #0a0707;
    --sig-cream: #f0e9dd;
    --sig-accent: #7a6b54;
  }

  html, body { background: var(--sig-ink); }

  .sig {
    color: var(--sig-cream);
    font-family: var(--font-body);
  }

  /* ============ PAGE BASE (PDF-like portrait, full-bleed photo) ============ */
  .sig-page {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    color: var(--sig-cream);
    display: flex;
    flex-direction: column;
    isolation: isolate;
  }

  /* Background photo (parallax-ready) */
  .sig-page__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: -2;
    /* Cinematic feel: slight zoom + warmth */
    filter: saturate(1.05) contrast(1.04);
    will-change: transform;
  }

  /* Dark veil for text legibility, gentler at top */
  .sig-page__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg,
        rgba(8, 4, 4, 0.55) 0%,
        rgba(8, 4, 4, 0.15) 35%,
        rgba(8, 4, 4, 0.2) 70%,
        rgba(8, 4, 4, 0.6) 100%);
  }
  .sig-page__veil--soft {
    background:
      linear-gradient(180deg,
        rgba(8, 4, 4, 0.4) 0%,
        rgba(8, 4, 4, 0.05) 40%,
        rgba(8, 4, 4, 0.35) 100%);
  }

  /* Content slot — text positioning */
  .sig-page__content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 7vw, 5.5rem);
    max-width: 60rem;
  }
  .sig-page__content--upper { justify-content: flex-start; padding-top: clamp(4rem, 10vh, 8rem); }
  .sig-page__content--center { justify-content: center; align-items: center; text-align: center; margin: 0 auto; padding-top: 0; }

  /* Footer caption (cover only) */
  .sig-page__footer {
    position: absolute;
    bottom: clamp(2.5rem, 6vh, 4rem);
    left: 0; right: 0;
    z-index: 1;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(0.95rem, 1.4vw, 1.25rem);
    letter-spacing: 0.05em;
    color: rgba(240, 233, 221, 0.92);
  }
  .sig-page__footer .sep { margin: 0 0.7em; color: rgba(240, 233, 221, 0.5); }

  /* Page number, bottom-right (like PDF "02", "03"…) */
  .sig-page__num {
    position: absolute;
    bottom: clamp(1rem, 2.5vh, 1.6rem);
    right: clamp(1.25rem, 3vw, 2.25rem);
    z-index: 2;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    color: rgba(240, 233, 221, 0.55);
  }

  /* ============ COVER ============ */
  .sig-cover__title {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(2.8rem, 8vw, 6.2rem);
    line-height: 1;
    letter-spacing: 0.35em;
    text-indent: 0.35em; /* compensate the trailing letter-spacing */
    color: var(--sig-cream);
    text-transform: uppercase;
    margin: 0;
  }
  .sig-cover__rule {
    width: 3rem;
    height: 1px;
    background: rgba(240, 233, 221, 0.5);
    margin: 1.6rem 0 0.9rem;
  }
  .sig-cover__edition {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(0.95rem, 1.2vw, 1.2rem);
    letter-spacing: 0.05em;
    color: rgba(240, 233, 221, 0.92);
    margin: 0;
  }
  .sig-cover__date {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 0.62rem;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.7);
    margin: 0.6rem 0 0;
    padding-left: 0.42em;
  }

  /* ============ MANIFESTO ============ */
  .sig-mani__lead {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    line-height: 1.3;
    color: var(--sig-cream);
    letter-spacing: -0.005em;
    margin: 0 0 2rem;
    max-width: 32ch;
  }
  .sig-mani__body {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-width: 32rem;
    margin-bottom: 2.5rem;
  }
  .sig-mani__body p {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: normal;
    font-size: clamp(0.95rem, 1.2vw, 1.15rem);
    line-height: 1.65;
    color: rgba(240, 233, 221, 0.92);
    margin: 0;
  }
  .sig-mani__close {
    font-family: var(--font-display);
