<script>
  // ===== Passcode gate (client-side; security-by-obscurity, fine for private invites) =====
  const gate = document.getElementById("sigGate") as HTMLElement | null;
  const main = document.getElementById("sigMain") as HTMLElement | null;
  const form = document.getElementById("sigGateForm") as HTMLFormElement | null;
  const input = document.getElementById("sigGateInput") as HTMLInputElement | null;
  const err = document.getElementById("sigGateErr") as HTMLElement | null;

  const unlock = () => {
    if (!gate || !main) return;
    main.hidden = false;
    gate.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    setTimeout(() => gate.remove(), 700);
    try {
      sessionStorage.setItem("sigUnlocked", "1");
    } catch {}
  };

  if (gate && main && form && input) {
    try {
      if (sessionStorage.getItem("sigUnlocked") === "1") {
        unlock();
      } else {
        document.body.style.overflow = "hidden";
        setTimeout(() => input.focus(), 300);
      }
    } catch {
      document.body.style.overflow = "hidden";
    }

    const expected = (gate.dataset.code || "").trim().toLowerCase();
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const v = input.value.trim().toLowerCase();
      if (v === expected) {
        unlock();
      } else if (err) {
        err.textContent = "Code not recognised.";
        input.select();
      }
    });
  }

  // ===== Newsletter: open prefilled email =====
  const news = document.getElementById("sigNews") as HTMLFormElement | null;
  const newsOk = document.getElementById("sigNewsOk") as HTMLElement | null;
  if (news) {
    news.addEventListener("submit", (e) => {
      e.preventDefault();
      const email = (news.querySelector('input[name="email"]') as HTMLInputElement).value.trim();
      if (!email) return;
      const subject = encodeURIComponent("Signature — Newsletter");
      const body = encodeURIComponent(`Hello Eugénie,\n\nPlease add me to the Signature newsletter.\n\nEmail: ${email}\n\nThank you.`);
      window.location.href = `mailto:eugeniecolleville.paris@gmail.com?subject=${subject}&body=${body}`;
      if (newsOk) newsOk.hidden = false;
    });
  }

  // Subtle parallax on background photos
  const bgs = document.querySelectorAll<HTMLElement>(".sig-page__bg");
  if (bgs.length && window.matchMedia("(min-width: 768px)").matches) {
    const update = () => {
      bgs.forEach((bg) => {
        const rect = bg.parentElement!.getBoundingClientRect();
        const vh = window.innerHeight;
        // Visible center of section relative to viewport
        const centerOffset = (rect.top + rect.height / 2 - vh / 2) / vh;
        const translate = Math.max(-40, Math.min(40, -centerOffset * 40));
        bg.style.transform = `translate3d(0, ${translate}px, 0) scale(1.08)`;
      });
    };
    update();
    let raf = 0;
    window.addEventListener(
      "scroll",
      () => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          update();
          raf = 0;
        });
      },
      { passive: true }
    );
  }
</script>
