---
import Layout from "../layouts/Layout.astro";

const title = "SIGNATURE — No. 01 · 27 September 2026 · Château Laffitte Carcasset";
const description =
  "Signature No. 01 — 27 September 2026 at Château Laffitte Carcasset, Saint-Estèphe. An evening where architecture, light, sound, gastronomy, conversation and performance are conceived as one.";
---

<Layout lang="en" title={title} description={description}>
  <main class="sig">

    <!-- ===== COVER ===== -->
    <section class="sig-page sig-page--cover">
      <div class="sig-page__bg" style="background-image: url('/images/signature/cover.jpg');"></div>
      <div class="sig-page__veil"></div>
      <div class="sig-page__content sig-page__content--center">
        <h1 class="sig-cover__title">SIGNATURE</h1>
        <div class="sig-cover__rule" aria-hidden="true"></div>
        <p class="sig-cover__edition">No. 01</p>
        <p class="sig-cover__date">September&nbsp;2026</p>
      </div>
      <div class="sig-page__footer">
        <span>Château Laffitte Carcasset</span>
        <span class="sep">·</span>
        <span>Saint-Estèphe</span>
      </div>
      <div class="sig-page__num" aria-hidden="true">01</div>
    </section>

    <!-- ===== MANIFESTO ===== -->
    <section class="sig-page sig-page--manifesto">
      <div class="sig-page__bg" style="background-image: url('/images/signature/manifesto.jpg');"></div>
      <div class="sig-page__veil sig-page__veil--soft"></div>
      <div class="sig-page__content sig-page__content--upper">
        <p class="sig-mani__lead" data-reveal>
          We&nbsp;shape&nbsp;environments.<br>
          People&nbsp;shape&nbsp;the&nbsp;experience.
        </p>
        <div class="sig-mani__body" data-reveal style="--reveal-delay:0.2s">
          <p>The places we inhabit influence how we think, behave and connect with one another. Light, sound, architecture, gastronomy, conversation and performance are conceived as one.</p>
          <p>Signature begins with a simple belief: meaningful moments don't happen by accident. They emerge when every element works in harmony.</p>
        </div>
        <p class="sig-mani__close" data-reveal style="--reveal-delay:0.45s">
          <em>What Signature becomes will evolve.<br>The intention will not.</em>
        </p>
      </div>
      <div class="sig-page__num" aria-hidden="true">02</div>
    </section>

    <!-- ===== ACT I ===== -->
    <section class="sig-page sig-page--act">
      <div class="sig-page__bg" style="background-image: url('/images/signature/act1.jpg');"></div>
      <div class="sig-page__veil"></div>
      <div class="sig-page__content sig-page__content--upper">
        <span class="sig-act__label" data-reveal>ACT&nbsp;&nbsp;I.</span>
        <h2 class="sig-act__line" data-reveal style="--reveal-delay:0.15s">
          Every edition begins with a place chosen for what it already possesses.
        </h2>
        <p class="sig-act__under" data-reveal style="--reveal-delay:0.35s">
          <em>Its identity isn't reinvented. It's revealed.</em>
        </p>
      </div>
      <div class="sig-page__num" aria-hidden="true">03</div>
    </section>

    <!-- ===== ACT II ===== -->
    <section class="sig-page sig-page--act">
      <div class="sig-page__bg" style="background-image: url('/images/signature/act2.jpg');"></div>
      <div class="sig-page__veil"></div>
      <div class="sig-page__content sig-page__content--upper">
        <span class="sig-act__label" data-reveal>ACT&nbsp;&nbsp;II.</span>
        <h2 class="sig-act__line" data-reveal style="--reveal-delay:0.15s">
          Every place follows its own rhythm.
        </h2>
        <p class="sig-act__under" data-reveal style="--reveal-delay:0.35s">
          <em>Not everything asks for immediate attention.</em>
        </p>
      </div>
      <div class="sig-page__num" aria-hidden="true">04</div>
    </section>

    <!-- ===== ACT III ===== -->
    <section class="sig-page sig-page--act">
      <div class="sig-page__bg" style="background-image: url('/images/signature/act3.jpg');"></div>
      <div class="sig-page__veil"></div>
      <div class="sig-page__content sig-page__content--upper">
        <span class="sig-act__label" data-reveal>ACT&nbsp;&nbsp;III.</span>
        <h2 class="sig-act__line" data-reveal style="--reveal-delay:0.15s">
          Some conversations deserve a setting.
        </h2>
        <p class="sig-act__under" data-reveal style="--reveal-delay:0.35s">
          <em>The evening begins before a single note is played.</em>
        </p>
      </div>
      <div class="sig-page__num" aria-hidden="true">05</div>
    </section>

    <!-- ===== ACT IV ===== -->
    <section class="sig-page sig-page--act">
      <div class="sig-page__bg" style="background-image: url('/images/signature/act4.jpg');"></div>
      <div class="sig-page__veil"></div>
      <div class="sig-page__content sig-page__content--upper">
        <span class="sig-act__label" data-reveal>ACT&nbsp;&nbsp;IV.</span>
        <h2 class="sig-act__line" data-reveal style="--reveal-delay:0.15s">
          As daylight fades.
        </h2>
        <p class="sig-act__under" data-reveal style="--reveal-delay:0.35s">
          <em>The soundtrack arrives quietly.</em>
        </p>
      </div>
      <div class="sig-page__num" aria-hidden="true">06</div>
    </section>

    <!-- ===== ACT V ===== -->
    <section class="sig-page sig-page--act sig-page--last">
      <div class="sig-page__bg" style="background-image: url('/images/signature/act5.jpg');"></div>
      <div class="sig-page__veil"></div>
      <div class="sig-page__content sig-page__content--upper">
        <span class="sig-act__label" data-reveal>ACT&nbsp;&nbsp;V.</span>
        <h2 class="sig-act__line" data-reveal style="--reveal-delay:0.15s">
          The day finds its own pace.
        </h2>
        <p class="sig-act__under" data-reveal style="--reveal-delay:0.35s">
          <em>Nothing is rushed. Nothing is imposed.</em>
        </p>
      </div>
      <div class="sig-page__num" aria-hidden="true">07</div>
    </section>

    <!-- ===== COLOPHON ===== -->
    <section class="sig-end">
      <div class="sig-end__inner" data-reveal>
        <div class="sig-end__mark">·</div>
        <p class="sig-end__line">SIGNATURE</p>
        <p class="sig-end__small">No. 01 &nbsp;·&nbsp; 27 September 2026</p>
        <p class="sig-end__venue"><em>Château Laffitte Carcasset</em> · Saint-Estèphe · Bordeaux</p>
        <p class="sig-end__contact">For invitations and conversation&nbsp;: <a href="mailto:eugeniecolleville.paris@gmail.com">eugeniecolleville.paris@gmail.com</a></p>
      </div>
    </section>

  </main>
</Layout>

<style>
  :root {
    --sig-ink: #0a0707;
    --sig-cream: #f0e9dd;
    --sig-accent: #7a6b54;
  }

  html, body { background: var(--sig-ink); }

  .sig {
    color: var(--sig-cream);
    font-family: var(--font-body);
  }

  /* ============ PAGE BASE (PDF-like portrait, full-bleed photo) ============ */
  .sig-page {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    color: var(--sig-cream);
    display: flex;
    flex-direction: column;
    isolation: isolate;
  }

  /* Background photo (parallax-ready) */
  .sig-page__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: -2;
    /* Cinematic feel: slight zoom + warmth */
    filter: saturate(1.05) contrast(1.04);
    will-change: transform;
  }

  /* Dark veil for text legibility, gentler at top */
  .sig-page__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg,
        rgba(8, 4, 4, 0.55) 0%,
        rgba(8, 4, 4, 0.15) 35%,
        rgba(8, 4, 4, 0.2) 70%,
        rgba(8, 4, 4, 0.6) 100%);
  }
  .sig-page__veil--soft {
    background:
      linear-gradient(180deg,
        rgba(8, 4, 4, 0.4) 0%,
        rgba(8, 4, 4, 0.05) 40%,
        rgba(8, 4, 4, 0.35) 100%);
  }

  /* Content slot — text positioning */
  .sig-page__content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 7vw, 5.5rem);
    max-width: 60rem;
  }
  .sig-page__content--upper { justify-content: flex-start; padding-top: clamp(4rem, 10vh, 8rem); }
  .sig-page__content--center { justify-content: center; align-items: center; text-align: center; margin: 0 auto; padding-top: 0; }

  /* Footer caption (cover only) */
  .sig-page__footer {
    position: absolute;
    bottom: clamp(2.5rem, 6vh, 4rem);
    left: 0; right: 0;
    z-index: 1;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(0.95rem, 1.4vw, 1.25rem);
    letter-spacing: 0.05em;
    color: rgba(240, 233, 221, 0.92);
  }
  .sig-page__footer .sep { margin: 0 0.7em; color: rgba(240, 233, 221, 0.5); }

  /* Page number, bottom-right (like PDF "02", "03"…) */
  .sig-page__num {
    position: absolute;
    bottom: clamp(1rem, 2.5vh, 1.6rem);
    right: clamp(1.25rem, 3vw, 2.25rem);
    z-index: 2;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    color: rgba(240, 233, 221, 0.55);
  }

  /* ============ COVER ============ */
  .sig-cover__title {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(2.8rem, 8vw, 6.2rem);
    line-height: 1;
    letter-spacing: 0.35em;
    text-indent: 0.35em; /* compensate the trailing letter-spacing */
    color: var(--sig-cream);
    text-transform: uppercase;
    margin: 0;
  }
  .sig-cover__rule {
    width: 3rem;
    height: 1px;
    background: rgba(240, 233, 221, 0.5);
    margin: 1.6rem 0 0.9rem;
  }
  .sig-cover__edition {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(0.95rem, 1.2vw, 1.2rem);
    letter-spacing: 0.05em;
    color: rgba(240, 233, 221, 0.92);
    margin: 0;
  }
  .sig-cover__date {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 0.62rem;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.7);
    margin: 0.6rem 0 0;
    padding-left: 0.42em;
  }

  /* ============ MANIFESTO ============ */
  .sig-mani__lead {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    line-height: 1.3;
    color: var(--sig-cream);
    letter-spacing: -0.005em;
    margin: 0 0 2rem;
    max-width: 32ch;
  }
  .sig-mani__body {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-width: 32rem;
    margin-bottom: 2.5rem;
  }
  .sig-mani__body p {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: normal;
    font-size: clamp(0.95rem, 1.2vw, 1.15rem);
    line-height: 1.65;
    color: rgba(240, 233, 221, 0.92);
    margin: 0;
  }
  .sig-mani__close {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    line-height: 1.55;
    color: rgba(240, 233, 221, 0.88);
    margin: 0;
    max-width: 32rem;
  }
  .sig-mani__close em { font-style: italic; }

  /* ============ ACTS (PDF style) ============ */
  .sig-act__label {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 400;
    font-style: normal;
    font-size: clamp(0.85rem, 1.1vw, 1.05rem);
    letter-spacing: 0.32em;
    color: var(--sig-cream);
    margin-bottom: clamp(3rem, 8vh, 6rem);
    opacity: 0.95;
    padding-left: 0.32em;
  }
  .sig-act__line {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 600;
    font-size: clamp(1.5rem, 2.6vw, 2.2rem);
    line-height: 1.3;
    letter-spacing: -0.003em;
    color: var(--sig-cream);
    margin: 0 0 1.25rem;
    max-width: 28ch;
  }
  .sig-act__under {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    line-height: 1.55;
    color: rgba(240, 233, 221, 0.85);
    margin: 0;
    max-width: 32ch;
  }
  .sig-act__under em { font-style: italic; }

  /* ============ END / COLOPHON ============ */
  .sig-end {
    min-height: 60vh;
    background: var(--sig-ink);
    color: var(--sig-cream);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 1.5rem;
    text-align: center;
  }
  .sig-end__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .sig-end__mark {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--sig-accent);
    margin-bottom: 0.5rem;
  }
  .sig-end__line {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(1.4rem, 2.6vw, 2.2rem);
    color: var(--sig-cream);
    line-height: 1;
    letter-spacing: 0.35em;
    text-indent: 0.35em;
    margin: 0;
  }
  .sig-end__small {
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.55);
    margin-top: 0.6rem;
  }
  .sig-end__venue {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.4vw, 1.3rem);
    color: rgba(240, 233, 221, 0.85);
    letter-spacing: 0.02em;
  }
  .sig-end__venue em { font-style: italic; }
  .sig-end__contact {
    margin-top: 2.5rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: rgba(240, 233, 221, 0.7);
    letter-spacing: 0.05em;
  }
  .sig-end__contact a {
    color: var(--sig-cream);
    border-bottom: 1px solid rgba(240, 233, 221, 0.35);
    padding-bottom: 1px;
    transition: opacity 0.4s var(--ease);
  }
  .sig-end__contact a:hover { opacity: 0.7; }

  @media (max-width: 600px) {
    .sig-cover__title { letter-spacing: 0.25em; text-indent: 0.25em; font-size: 2.2rem; }
    .sig-act__label { margin-bottom: 3rem; }
    .sig-page__content { padding: 3rem 1.5rem; }
    .sig-page__content--upper { padding-top: 4rem; }
    .sig-mani__lead { font-size: 1.5rem; }
    .sig-act__line { font-size: 1.45rem; }
  }
</style>

<script>
  // Subtle parallax on background photos
  const bgs = document.querySelectorAll<HTMLElement>(".sig-page__bg");
  if (bgs.length && window.matchMedia("(min-width: 768px)").matches) {
    const update = () => {
      bgs.forEach((bg) => {
        const rect = bg.parentElement!.getBoundingClientRect();
        const vh = window.innerHeight;
        // Visible center of section relative to viewport
        const centerOffset = (rect.top + rect.height / 2 - vh / 2) / vh;
        const translate = Math.max(-40, Math.min(40, -centerOffset * 40));
        bg.style.transform = `translate3d(0, ${translate}px, 0) scale(1.08)`;
      });
    };
    update();
    let raf = 0;
    window.addEventListener(
      "scroll",
      () => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          update();
          raf = 0;
        });
      },
      { passive: true }
    );
  }
</script>
