---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import PressStrip from "../components/PressStrip.astro";
import Clients from "../components/Clients.astro";
import About from "../components/About.astro";
import Partners from "../components/Partners.astro";
import Services from "../components/Services.astro";
import Press from "../components/Press.astro";
import Contact from "../components/Contact.astro";
import Story from "../components/Story.astro";
import Footer from "../components/Footer.astro";
import { content } from "../data/content.js";

const lang = "en";
const meta = content[lang].meta;
---

<Layout lang={lang} title={meta.title} description={meta.description}>
  <Nav lang={lang} />
  <main>
    <Hero lang={lang} />
    <PressStrip lang={lang} />
    <Clients lang={lang} />
    <About lang={lang} />
    <Partners lang={lang} />
    <Services lang={lang} />
    <Press lang={lang} />
    <Contact lang={lang} />
    <Story lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
