---
import Layout from "../layouts/Layout.astro";

const title = "SIGNATURE — Programme · 26-27 September 2026";
const description = "The full 24-hour programme of Signature No. 01 at Château Laffitte Carcasset, 26-27 September 2026.";
---

<Layout lang="en" title={title} description={description}>

  <!-- ===== PASSCODE GATE (same code, shared session) ===== -->
  <div id="sigGate" class="sig-gate" data-code="carcasset" aria-hidden="false">
    <div class="sig-gate__bg sig-gate__bg--video">
      <video autoplay muted loop playsinline preload="auto" poster="/videos/signature/seal-poster.jpg">
        <source src="/videos/signature/seal.mp4" type="video/mp4">
      </video>
    </div>
    <div class="sig-gate__inner">
      <p class="sig-gate__brand">SIGNATURE</p>
      <p class="sig-gate__sub">Programme &nbsp;·&nbsp; By invitation only</p>
      <form class="sig-gate__form" id="sigGateForm">
        <input type="text" id="sigGateInput" autocomplete="off" placeholder="Access&nbsp;code" aria-label="Access code" autocapitalize="none" autocorrect="off" spellcheck="false">
        <button type="submit">Enter</button>
      </form>
      <p class="sig-gate__err" id="sigGateErr" aria-live="polite"></p>
    </div>
  </div>

  <main class="prg" id="sigMain" hidden>

    <!-- ===== HEADER ===== -->
    <header class="prg-hero">
      <a class="prg-back" href="/signature" aria-label="Back to invitation">← Invitation</a>
      <p class="prg-eyebrow">The Programme</p>
      <h1 class="prg-title">24&nbsp;Hours</h1>
      <p class="prg-sub"><em>26–27 September 2026 &nbsp;·&nbsp; Château Laffitte Carcasset</em></p>
      <div class="prg-rule"></div>
    </header>

    <!-- ===== 24 HOURS ===== -->
    <section class="prg-days">
      <div class="prg-days__grid">

        <div class="prg-day" data-reveal>
          <p class="prg-day__label">Day 01 &nbsp;·&nbsp; Evening</p>
          <ol class="prg-day__list">
            <li><span class="t">18:30</span><span class="e">Arrival</span><span class="s"><em>Signature cocktail</em></span></li>
            <li><span class="t">19:30</span><span class="e">Golden Hour</span><span class="s"><em>Explore the Estate</em></span></li>
            <li><span class="t">20:00</span><span class="e">Dinner</span><span class="s"><em>Seasonal gathering</em></span></li>
            <li><span class="t">22:00</span><span class="e">Ambience</span><span class="s"><em>The rise</em></span></li>
            <li><span class="t">23:00</span><span class="e">Rave</span><span class="s"><em>The show is on</em></span></li>
            <li><span class="t">03:00</span><span class="e">Late Night</span><span class="s"><em>After glow</em></span></li>
          </ol>
        </div>

        <div class="prg-day" data-reveal style="--reveal-delay:0.15s">
          <p class="prg-day__label">Day 02 &nbsp;·&nbsp; Morning Energy</p>
          <ol class="prg-day__list">
            <li><span class="t">10:00</span><span class="e">Le Petit Déjeuner</span><span class="s"><em>Coffee, pastries</em></span></li>
            <li><span class="t">11:30</span><span class="e">Brunch</span><span class="s"><em>The perfect recovery</em></span></li>
            <li><span class="t">13:30</span><span class="e">Breath</span><span class="s"><em>Yoga, breath work, pilates</em></span></li>
            <li><span class="t">14:00</span><span class="e">Reconnect</span><span class="s"><em>Poolside, lounge, terrace</em></span></li>
            <li><span class="t">17:00</span><span class="e">Curtain Close</span><span class="s"><em>Act · 01 over</em></span></li>
          </ol>
        </div>

      </div>

      <div class="prg-next" data-reveal>
        <p class="prg-next__title"><em>The Next Day</em></p>
        <p>No rush. No schedule. Just breakfast, brunch and relaxing time on the menu. Follow the yoga instructor at first light, or rest by the poolside.</p>
      </div>
    </section>

    <!-- ===== NOTES ===== -->
    <section class="prg-notes">
      <div class="prg-notes__inner">

        <article class="prg-note" data-reveal>
          <p class="prg-note__label">The Scenery</p>
          <p class="prg-note__body">Architecture is never hidden. Every detail is designed to reveal the character of the place rather than transform it. Light, fabric and sound are introduced with restraint, allowing the architecture to remain at the centre of the experience.</p>
        </article>

        <article class="prg-note" data-reveal style="--reveal-delay:0.15s">
          <p class="prg-note__label">Place</p>
          <p class="prg-note__body">Built in the eighteenth century and surrounded by the vineyards of Saint-Estèphe, Château Laffitte Carcasset reflects the character of the Médoc through its architecture, history and landscape.</p>
        </article>

        <article class="prg-note" data-reveal style="--reveal-delay:0.3s">
          <p class="prg-note__label">Music</p>
          <p class="prg-note__body">Music direction shaped by years behind the decks, drawing from underground electronic music with a focus on atmosphere, rhythm and progression.</p>
        </article>

      </div>
    </section>

    <!-- ===== CTA BACK TO SIGNATURE ===== -->
    <section class="prg-cta">
      <a href="/signature" class="prg-cta__link">Return to the invitation</a>
    </section>

  </main>
</Layout>

<style>
  :root {
    --sig-ink: #0a0707;
    --sig-cream: #f0e9dd;
    --sig-accent: #7a6b54;
  }
  html, body { background: var(--sig-ink); }
  .prg { color: var(--sig-cream); font-family: var(--font-body); }

  /* ==== PASSCODE GATE (mirrors /signature) ==== */
  .sig-gate {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--sig-ink);
    overflow: hidden;
    opacity: 1;
    transition: opacity 0.6s var(--ease, ease);
  }
  .sig-gate[aria-hidden="true"] { opacity: 0; pointer-events: none; }
  .sig-gate__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: blur(2px) brightness(0.45);
    z-index: 0;
    overflow: hidden;
  }
  .sig-gate__bg--video video {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
  }
  .sig-gate__bg--video::after {
    content: "";
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at center, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.75) 80%);
    pointer-events: none;
  }
  .sig-gate__inner {
    position: relative; z-index: 1;
    text-align: center;
    color: var(--sig-cream);
    padding: 2rem;
    max-width: 28rem;
  }
  .sig-gate__brand {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    letter-spacing: 0.35em;
    text-indent: 0.35em;
    margin: 0 0 0.75rem;
  }
  .sig-gate__sub {
    font-family: var(--font-body);
    font-size: 0.65rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.7);
    margin: 0 0 2.5rem;
  }
  .sig-gate__form { display: flex; gap: 0.5rem; justify-content: center; }
  .sig-gate__form input {
    background: rgba(240, 233, 221, 0.08);
    border: 1px solid rgba(240, 233, 221, 0.35);
    color: var(--sig-cream);
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.05em;
    padding: 0.85rem 1rem;
    width: 14rem;
    text-align: center;
    outline: none;
    transition: border-color 0.3s ease;
  }
  .sig-gate__form input::placeholder { color: rgba(240, 233, 221, 0.4); letter-spacing: 0.05em; }
  .sig-gate__form input:focus { border-color: rgba(240, 233, 221, 0.85); }
  .sig-gate__form button {
    background: var(--sig-cream);
    color: var(--sig-ink);
    border: none;
    padding: 0.85rem 1.4rem;
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }
  .sig-gate__form button:hover { opacity: 0.85; }
  .sig-gate__err {
    min-height: 1.2em;
    margin-top: 1rem;
    font-family: var(--font-body);
    font-size: 0.7rem;
    color: rgba(240, 233, 221, 0.7);
  }

  /* ==== HERO ==== */
  .prg-hero {
    padding: clamp(4rem, 10vh, 7rem) 1.5rem clamp(2rem, 5vh, 3.5rem);
    text-align: center;
    position: relative;
  }
  .prg-back {
    position: absolute;
    top: clamp(1.4rem, 3vh, 2rem);
    left: clamp(1.5rem, 4vw, 3rem);
    font-family: var(--font-body);
    font-size: 0.62rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.7);
    text-decoration: none;
    transition: color 0.3s ease;
  }
  .prg-back:hover { color: var(--sig-cream); }
  .prg-eyebrow {
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.6);
    margin: 0 0 1.4rem;
    padding-left: 0.4em;
  }
  .prg-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.8rem, 6vw, 4.8rem);
    line-height: 1;
    margin: 0 0 0.8rem;
    color: var(--sig-cream);
  }
  .prg-sub {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    color: rgba(240, 233, 221, 0.8);
    margin: 0;
  }
  .prg-sub em { font-style: italic; }
  .prg-rule {
    width: 3.5rem;
    height: 1px;
    background: rgba(240, 233, 221, 0.4);
    margin: 1.8rem auto 0;
  }

  /* ==== DAYS ==== */
  .prg-days {
    padding: clamp(3rem, 7vh, 5rem) clamp(1.5rem, 5vw, 4rem) clamp(5rem, 10vh, 7rem);
  }
  .prg-days__grid {
    max-width: 68rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
  }
  .prg-day__label {
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.62);
    margin: 0 0 2rem;
    padding-left: 0.4em;
  }
  .prg-day__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .prg-day__list li {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    grid-template-areas: "time entry" ". sub";
    padding: 1.15rem 0;
    border-top: 1px solid rgba(240, 233, 221, 0.08);
  }
  .prg-day__list li:first-child { border-top: none; padding-top: 0; }
  .prg-day__list li .t {
    grid-area: time;
    font-family: var(--font-body);
    font-size: 0.68rem;
    letter-spacing: 0.28em;
    color: rgba(240, 233, 221, 0.72);
    padding-top: 0.15rem;
  }
  .prg-day__list li .e {
    grid-area: entry;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    color: var(--sig-cream);
  }
  .prg-day__list li .s {
    grid-area: sub;
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: rgba(240, 233, 221, 0.6);
    margin-top: 0.2rem;
  }
  .prg-day__list li .s em { font-style: italic; }

  .prg-next {
    max-width: 36rem;
    margin: clamp(4rem, 8vh, 6rem) auto 0;
    text-align: center;
    padding-top: clamp(3rem, 6vh, 4rem);
    border-top: 1px solid rgba(240, 233, 221, 0.12);
  }
  .prg-next__title {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    color: var(--sig-cream);
    margin: 0 0 0.9rem;
  }
  .prg-next__title em { font-style: italic; }
  .prg-next p:not(.prg-next__title) {
    font-family: var(--font-display);
    font-size: 0.98rem;
    line-height: 1.65;
    color: rgba(240, 233, 221, 0.78);
    margin: 0;
  }

  /* ==== NOTES ==== */
  .prg-notes {
    padding: clamp(4rem, 10vh, 6rem) clamp(1.5rem, 5vw, 4rem);
    border-top: 1px solid rgba(240, 233, 221, 0.06);
  }
  .prg-notes__inner {
    max-width: 70rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
  }
  .prg-note__label {
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(240, 233, 221, 0.6);
    margin: 0 0 1.1rem;
    padding-left: 0.4em;
  }
  .prg-note__body {
    font-family: var(--font-display);
    font-size: 0.98rem;
    line-height: 1.65;
    color: rgba(240, 233, 221, 0.82);
    margin: 0;
  }

  /* ==== CTA back ==== */
  .prg-cta {
    padding: clamp(5rem, 10vh, 7rem) 1.5rem;
    text-align: center;
    border-top: 1px solid rgba(240, 233, 221, 0.06);
  }
  .prg-cta__link {
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--sig-cream);
    text-decoration: none;
    padding: 1rem 2rem;
    border: 1px solid rgba(240, 233, 221, 0.35);
    transition: border-color 0.3s ease, background 0.3s ease;
  }
  .prg-cta__link:hover {
    border-color: rgba(240, 233, 221, 0.85);
    background: rgba(240, 233, 221, 0.05);
  }

  @media (max-width: 780px) {
    .prg-days__grid { grid-template-columns: 1fr; gap: 0; }
    .prg-days__grid .prg-day + .prg-day {
      margin-top: 3rem;
      padding-top: 3rem;
      border-top: 1px solid rgba(240, 233, 221, 0.14);
    }
    .prg-notes__inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .sig-gate__form { flex-direction: column; }
    .sig-gate__form input { width: 100%; }
  }
</style>

<script>
  // ===== Passcode gate — shared sessionStorage with /signature =====
  const gate = document.getElementById("sigGate") as HTMLElement | null;
  const main = document.getElementById("sigMain") as HTMLElement | null;
  const form = document.getElementById("sigGateForm") as HTMLFormElement | null;
  const input = document.getElementById("sigGateInput") as HTMLInputElement | null;
  const err = document.getElementById("sigGateErr") as HTMLElement | null;

  const unlock = () => {
    if (!gate || !main) return;
    main.hidden = false;
    gate.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    setTimeout(() => gate.remove(), 700);
    try { sessionStorage.setItem("sigUnlocked", "1"); } catch {}
  };

  if (gate && main && form && input) {
    try {
      if (sessionStorage.getItem("sigUnlocked") === "1") { unlock(); }
      else {
        document.body.style.overflow = "hidden";
        setTimeout(() => input.focus(), 300);
      }
    } catch { document.body.style.overflow = "hidden"; }

    const expected = (gate.dataset.code || "").trim().toLowerCase();
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const v = input.value.trim().toLowerCase();
      if (v === expected) unlock();
      else if (err) { err.textContent = "Code not recognised."; input.select(); }
    });
  }
</script>
