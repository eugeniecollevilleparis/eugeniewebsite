---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import PressStrip from "../components/PressStrip.astro";
import About from "../components/About.astro";
import Story from "../components/Story.astro";
import Services from "../components/Services.astro";
import Clients from "../components/Clients.astro";
import Press from "../components/Press.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";

const lang = "fr";
const title = "Eugénie Colleville — Chef privée · Paris · Londres";
const description =
  "Expérience de chef privée sur mesure. Formée par Alain Ducasse. Au service de clients privés, familles UHNWI et marques à Londres, Paris, sur la Côte d'Azur et à l'international.";
---

<Layout lang={lang} title={title} description={description}>
  <Nav lang={lang} />
  <main>
    <Hero lang={lang} />
    <PressStrip lang={lang} />
    <About lang={lang} />
    <Story lang={lang} />
    <Services lang={lang} />
    <Clients lang={lang} />
    <Press lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
