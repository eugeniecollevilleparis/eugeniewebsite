---
import { content } from "../data/content.js";
const lang = Astro.props.lang ?? "en";
const t = content[lang].contact;
---

<section class="contact section section--dark" id="contact">
  <div class="contact__media">
    <div class="placeholder placeholder--dark" data-label="Atmosphere · table · candlelight · 2880×1600"></div>
    <div class="contact__overlay"></div>
  </div>

  <div class="contact__inner container">
    <span class="eyebrow" data-reveal>{t.tag}</span>

    <h2 class="display display-1 contact__title" data-reveal style="--reveal-delay:0.1s">
      {t.title}
      <br />
      <em>{t.titleEm}</em>
    </h2>

    <div class="contact__rule" data-reveal style="--reveal-delay:0.2s"></div>

    <p class="contact__sub" data-reveal style="--reveal-delay:0.25s">{t.sub}</p>

    <div class="contact__cta" data-reveal style="--reveal-delay:0.4s">
      <a href={`mailto:${t.email}`} class="btn btn--invert btn--solid">{t.emailLabel}</a>
      <a href={t.website} target="_blank" rel="noopener" class="btn btn--invert">{t.websiteLabel}</a>
    </div>

    <p class="contact__links" data-reveal style="--reveal-delay:0.55s">
      <a href={t.instagramUrl} target="_blank" rel="noopener">{t.instagram}</a>
      <span class="contact__sep">·</span>
      <a href={t.website} target="_blank" rel="noopener">{t.websiteDisplay}</a>
    </p>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    color: var(--paper);
    min-height: 90vh;
    display: flex;
    align-items: center;
  }

  .contact__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .contact__media .placeholder {
    width: 100%;
    height: 100%;
  }

  .contact__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15, 13, 12, 0.55) 0%, rgba(15, 13, 12, 0.85) 100%);
  }

  .contact__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 1000px;
    text-align: center;
    align-items: center;
  }

  .contact__title {
    color: var(--paper);
    max-width: 18ch;
    font-weight: 300;
    font-style: normal;
  }

  .contact__title em {
    font-weight: 300;
    font-style: italic;
    opacity: 0.92;
  }

  .contact__rule {
    width: 4rem;
    height: 1px;
    background: rgba(245, 241, 234, 0.5);
    margin: 0.75rem 0;
  }

  .contact__sub {
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(245, 241, 234, 0.7);
  }

  .contact__cta {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn.btn--invert.btn--solid {
    background: var(--paper);
    color: var(--ink);
  }

  .btn.btn--invert.btn--solid:hover {
    background: transparent;
    color: var(--paper);
  }

  .contact__links {
    margin-top: 2.5rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: rgba(245, 241, 234, 0.78);
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .contact__links a {
    transition: opacity var(--dur-fast);
  }

  .contact__links a:hover {
    opacity: 0.6;
  }

  .contact__sep {
    opacity: 0.4;
  }

  @media (max-width: 768px) {
    .contact__cta {
      flex-direction: column;
      width: 100%;
      max-width: 18rem;
    }
    .contact__cta .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
