---
import { content } from "../data/content.js";
const lang = Astro.props.lang ?? "en";
const t = content[lang].contact;
---

<section class="contact section" id="contact">
  <div class="contact__inner container">
    <span class="eyebrow" data-reveal>{t.tag}</span>

    <h2 class="display display-1 contact__title" data-reveal style="--reveal-delay:0.1s">
      {t.title}
      <br />
      <em>{t.titleEm}</em>
    </h2>

    <div class="contact__rule" data-reveal style="--reveal-delay:0.2s"></div>

    <p class="contact__sub" data-reveal style="--reveal-delay:0.25s">{t.sub}</p>

    <div class="contact__cta" data-reveal style="--reveal-delay:0.4s">
      <a href={`mailto:${t.email}`} class="btn btn--solid">{t.emailLabel}</a>
    </div>

    <p class="contact__links" data-reveal style="--reveal-delay:0.55s">
      <a href={`mailto:${t.email}`}>{t.email}</a>
      <span class="contact__sep">·</span>
      <a href={t.instagramUrl} target="_blank" rel="noopener">{t.instagram}</a>
    </p>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    color: var(--ink);
    background: var(--paper-light);
    min-height: 80vh;
    display: flex;
    align-items: center;
    border-top: 1px solid var(--rule-soft);
    border-bottom: 1px solid var(--rule-soft);
  }

  .contact__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 1000px;
    text-align: center;
    align-items: center;
  }

  .contact__title {
    color: var(--ink);
    max-width: 18ch;
    font-weight: 300;
    font-style: normal;
  }

  .contact__title em {
    font-weight: 300;
    font-style: italic;
    color: var(--accent);
  }

  .contact__rule {
    width: 4rem;
    height: 1px;
    background: var(--accent);
    margin: 0.75rem 0;
  }

  .contact__sub {
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .contact__cta {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .contact__links {
    margin-top: 2.5rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--ink-soft);
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .contact__links a {
    transition: opacity var(--dur-fast);
  }

  .contact__links a:hover {
    opacity: 0.6;
  }

  .contact__sep {
    opacity: 0.4;
  }

  @media (max-width: 768px) {
    .contact__cta {
      flex-direction: column;
      width: 100%;
      max-width: 18rem;
    }
    .contact__cta .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
