---
// Floating "back to top" button — appears after scrolling down
---

<button class="back-to-top" data-back-to-top aria-label="Back to top" type="button">
  <span class="back-to-top__circle">
    <span class="back-to-top__mark" aria-hidden="true">e</span>
  </span>
</button>

<script>
  const btn = document.querySelector("[data-back-to-top]") as HTMLButtonElement | null;
  if (btn) {
    const onScroll = () => {
      if (window.scrollY > 600) btn.classList.add("is-visible");
      else btn.classList.remove("is-visible");
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    btn.addEventListener("click", () => {
      // Try Lenis first if it's exposed; fallback to native smooth scroll
      const w = window as any;
      if (w.__lenis && typeof w.__lenis.scrollTo === "function") {
        w.__lenis.scrollTo(0, { duration: 1.6 });
      } else {
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    });
  }
</script>

<style>
  .back-to-top {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--ink);

    opacity: 0;
    transform: translateY(0.75rem);
    pointer-events: none;
    transition:
      opacity 0.5s var(--ease),
      transform 0.5s var(--ease);
  }

  .back-to-top.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .back-to-top__circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    /* Same color as the page background — blends in */
    background: var(--paper);
    border: 1px solid var(--rule);
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background 0.4s var(--ease),
      color 0.4s var(--ease),
      border-color 0.4s var(--ease),
      transform 0.5s var(--ease);
  }

  .back-to-top:hover .back-to-top__circle {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
    transform: translateY(-3px);
  }

  .back-to-top__mark {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--ink);
    transform: translateY(-2px);
    transition: color 0.4s var(--ease);
  }

  .back-to-top:hover .back-to-top__mark {
    color: var(--paper);
  }

  @media (max-width: 600px) {
    .back-to-top__circle {
      width: 36px;
      height: 36px;
    }
    .back-to-top__mark {
      font-size: 1.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top,
    .back-to-top__circle,
    .back-to-top__label,
    .back-to-top svg {
      transition: none !important;
    }
  }
</style>
