---
import { content } from "../data/content.js";
const lang = Astro.props.lang ?? "en";
const t = content[lang].about;
---

<section class="about section" id="about">
  <div class="about__grid container">
    <div class="about__copy">
      <span class="eyebrow" data-reveal>{t.tag}</span>

      <h2 class="display display-2 about__title" data-reveal style="--reveal-delay:0.1s">
        {t.title} <em>{t.titleEm}</em>
      </h2>

      <div class="about__rule" data-reveal style="--reveal-delay:0.15s"></div>

      <div class="about__sub" data-reveal style="--reveal-delay:0.2s">With Alain Ducasse</div>

      <p class="about__p" data-reveal style="--reveal-delay:0.25s" set:html={t.p1Html}></p>
      <p class="about__p" data-reveal style="--reveal-delay:0.3s" set:html={t.p2Html}></p>
      <p class="about__p" data-reveal style="--reveal-delay:0.35s">{t.p3}</p>

      <blockquote class="about__quote" data-reveal style="--reveal-delay:0.4s">
        <p>{t.quote}</p>
        <cite>— {t.quoteAuthor}</cite>
      </blockquote>
    </div>

    <div class="about__aside">
      <figure class="about__media" data-reveal-image>
        <img
          src={t.photo}
          alt={`Eugénie Colleville — ${t.photoCaption}`}
          loading="lazy"
        />
        <figcaption class="about__caption">{t.photoCaption}</figcaption>
      </figure>

      <ul class="stats">
        {t.stats.map((s, i) => (
          <li class="stat" data-reveal style={`--reveal-delay:${0.2 + i * 0.08}s`}>
            <span class="stat__n">{s.n}</span>
            <span class="stat__l">{s.l.split("\n").map((line, idx) => (
              <>{idx > 0 && <br />}{line}</>
            ))}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    background: var(--paper-light);
    color: var(--ink);
    overflow: hidden;
    isolation: isolate;
  }

  /* Discreet wagyu+lobster+caviar watermark on the left side */
  .about::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("/images/bg-wagyu.jpg");
    background-position: left center;
    background-repeat: no-repeat;
    background-size: clamp(360px, 36vw, 580px) auto;
    opacity: 0.16;
    filter: grayscale(28%) contrast(0.95);
    mix-blend-mode: multiply;
    pointer-events: none;
    z-index: 0;
  }

  .about::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--paper-light) 0%, rgba(251, 249, 244, 0) 30%, rgba(251, 249, 244, 0) 70%, var(--paper-light) 100%);
    pointer-events: none;
    z-index: 1;
  }

  .about > * {
    position: relative;
    z-index: 2;
  }

  @media (max-width: 768px) {
    .about::before {
      background-size: 75vw auto;
      background-position: left -10vw center;
      opacity: 0.1;
    }
  }

  .about__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: start;
  }

  .about__copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about__title {
    margin-top: 0.5rem;
    font-weight: 300;
  }

  .about__title em {
    font-style: italic;
    font-weight: 300;
    display: block;
  }

  .about__rule {
    width: 4rem;
    height: 1px;
    background: var(--accent);
    margin: 0.75rem 0 0.5rem;
  }

  .about__sub {
    font-family: var(--font-body);
    font-size: 0.55rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(15, 13, 12, 0.5);
    margin-bottom: 0.75rem;
  }

  .about__p {
    max-width: 50ch;
    font-size: 0.92rem;
    line-height: 1.85;
  }

  .about__p :global(strong) {
    font-weight: 500;
    color: var(--ink);
  }

  .about__quote {
    margin-top: 1.5rem;
    padding: 1.5rem 0 0 1.75rem;
    border-left: 1px solid var(--rule);
    max-width: 42ch;
  }

  .about__quote p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.1rem, 1.4vw, 1.4rem);
    line-height: 1.5;
    color: var(--ink);
    font-weight: 400;
  }

  .about__quote cite {
    display: block;
    margin-top: 1rem;
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(15, 13, 12, 0.5);
    font-style: normal;
  }

  .about__aside {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .about__media {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    position: relative;
    background: var(--paper-deep);
  }

  .about__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(20%);
    transition: filter 0.6s var(--ease);
  }

  .about__media:hover img {
    filter: grayscale(0%);
  }

  .about__caption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    font-family: var(--font-body);
    font-size: 0.55rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--paper);
    background: rgba(15, 13, 12, 0.55);
    backdrop-filter: blur(8px);
    padding: 0.5rem 0.85rem;
  }

  .stats {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  .stat {
    background: var(--paper-light);
    padding: 1.75rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: center;
    align-items: center;
  }

  .stat__n {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    line-height: 1;
    color: var(--ink);
  }

  .stat__l {
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .about__grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .about__media {
      max-width: 28rem;
      align-self: center;
    }
  }
</style>
