---
import { content } from "../data/content.js";
const lang = Astro.props.lang ?? "en";
const t = content[lang].about;
---

<section class="about section" id="about">
  <div class="about__grid container">
    <div class="about__copy">
      <span class="eyebrow" data-reveal>{t.tag}</span>

      <h2 class="display display-2 about__title" data-reveal style="--reveal-delay:0.1s">
        {t.title} <em>{t.titleEm}</em>
      </h2>

      <div class="about__rule" data-reveal style="--reveal-delay:0.15s"></div>

      <div class="about__sub" data-reveal style="--reveal-delay:0.2s">With Alain Ducasse</div>

      <p class="about__p" data-reveal style="--reveal-delay:0.25s" set:html={t.p1Html}></p>
      <p class="about__p" data-reveal style="--reveal-delay:0.3s" set:html={t.p2Html}></p>
      <p class="about__p" data-reveal style="--reveal-delay:0.35s">{t.p3}</p>

      <blockquote class="about__quote" data-reveal style="--reveal-delay:0.4s">
        <p>{t.quote}</p>
        <cite>— {t.quoteAuthor}</cite>
      </blockquote>
    </div>

    <div class="about__aside">
      <div class="about__media" data-reveal-image>
        <div class="placeholder" data-label="Portrait · 1200×1500 · Eugénie portrait"></div>
      </div>

      <ul class="stats">
        {t.stats.map((s, i) => (
          <li class="stat" data-reveal style={`--reveal-delay:${0.2 + i * 0.08}s`}>
            <span class="stat__n">{s.n}</span>
            <span class="stat__l">{s.l.split("\n").map((line, idx) => (
              <>{idx > 0 && <br />}{line}</>
            ))}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--paper-light);
    color: var(--ink);
  }

  .about__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: start;
  }

  .about__copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about__title {
    margin-top: 0.5rem;
    font-weight: 300;
  }

  .about__title em {
    font-style: italic;
    font-weight: 300;
    display: block;
  }

  .about__rule {
    width: 4rem;
    height: 1px;
    background: var(--accent);
    margin: 0.75rem 0 0.5rem;
  }

  .about__sub {
    font-family: var(--font-body);
    font-size: 0.55rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(15, 13, 12, 0.5);
    margin-bottom: 0.75rem;
  }

  .about__p {
    max-width: 50ch;
    font-size: 0.92rem;
    line-height: 1.85;
  }

  .about__p :global(strong) {
    font-weight: 500;
    color: var(--ink);
  }

  .about__quote {
    margin-top: 1.5rem;
    padding: 1.5rem 0 0 1.75rem;
    border-left: 1px solid var(--rule);
    max-width: 42ch;
  }

  .about__quote p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.1rem, 1.4vw, 1.4rem);
    line-height: 1.5;
    color: var(--ink);
    font-weight: 400;
  }

  .about__quote cite {
    display: block;
    margin-top: 1rem;
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(15, 13, 12, 0.5);
    font-style: normal;
  }

  .about__aside {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .about__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    position: relative;
  }

  .about__media .placeholder {
    width: 100%;
    height: 100%;
  }

  .stats {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  .stat {
    background: var(--paper-light);
    padding: 1.75rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: center;
    align-items: center;
  }

  .stat__n {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    line-height: 1;
    color: var(--ink);
  }

  .stat__l {
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .about__grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .about__media {
      max-width: 28rem;
      align-self: center;
    }
  }
</style>
