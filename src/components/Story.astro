---
import { content } from "../data/content.js";
const lang = Astro.props.lang ?? "en";
const t = content[lang].story;
---

<section class="story section" id="story">
  <div class="container">
    <header class="story__head">
      <span class="eyebrow" data-reveal>{t.tag}</span>
      <h2 class="display display-2 story__title" data-reveal style="--reveal-delay:0.1s">
        {t.title} <em>{t.titleEm}</em>
      </h2>
      <div class="story__rule" data-reveal style="--reveal-delay:0.15s"></div>
    </header>

    <div class="story__body">
      {t.paragraphsHtml.map((html, i) => (
        <p class="story__p" data-reveal style={`--reveal-delay:${0.1 + i * 0.05}s`} set:html={html}></p>
      ))}

      <blockquote class="story__quote" data-reveal>
        <p>{t.quote}</p>
        <cite>— {t.quoteAuthor}</cite>
      </blockquote>

      <div class="story__thanks" data-reveal>
        <span class="story__thanks-label">{t.thanksLabel}</span>
        <p class="story__thanks-text" set:html={t.thanksHtml}></p>
      </div>
    </div>
  </div>
</section>

<style>
  .story {
    position: relative;
    background: var(--paper-light);
    overflow: hidden;
    isolation: isolate;
  }

  /* Tartare + caviar photo as a discreet watermark on the right side
     — radial mask attenuates the edges so only the plate stays visible. */
  /* Tartare + caviar photo — anchored to the LEFT, clearly visible */
  .story::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("/images/bg-tartare.jpg");
    background-position: left center;
    background-repeat: no-repeat;
    background-size: clamp(380px, 38vw, 620px) auto;
    opacity: 0.45;
    filter: grayscale(15%) contrast(0.98);
    mix-blend-mode: multiply;
    pointer-events: none;
    z-index: 0;
  }

  /* Fade the left/right edges so it blends into the paper */
  .story::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--paper-light) 0%, rgba(251, 249, 244, 0) 30%, rgba(251, 249, 244, 0) 70%, var(--paper-light) 100%);
    pointer-events: none;
    z-index: 1;
  }

  .story > * {
    position: relative;
    z-index: 2;
  }

  @media (max-width: 768px) {
    .story::before {
      background-size: 80vw auto;
      background-position: right -15vw center;
      opacity: 0.16;
    }
  }

  .story__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.2rem;
    margin-bottom: clamp(3rem, 6vh, 4.5rem);
  }

  .story__title {
    font-weight: 300;
  }

  .story__title em {
    font-style: italic;
    font-weight: 300;
  }

  .story__rule {
    width: 4rem;
    height: 1px;
    background: var(--accent);
    margin: 0.75rem 0;
  }

  .story__body {
    max-width: 60ch;
    margin: 0 auto;
  }

  .story__p {
    font-size: 0.95rem;
    line-height: 2.05;
    color: var(--ink-soft);
    margin-bottom: 1.75rem;
  }

  .story__p :global(strong) {
    color: var(--ink);
    font-weight: 500;
  }

  .story__p:first-child::first-letter {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 3.5em;
    line-height: 0.8;
    float: left;
    margin-right: 0.6rem;
    margin-top: 0.18em;
    color: var(--accent);
  }

  .story__quote {
    margin-top: 2.75rem;
    padding-left: 1.75rem;
    border-left: 1px solid var(--rule);
  }

  .story__quote p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.05rem, 1.3vw, 1.3rem);
    line-height: 1.6;
    color: var(--ink);
  }

  .story__quote cite {
    display: block;
    margin-top: 1rem;
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(15, 13, 12, 0.55);
    font-style: normal;
  }

  .story__thanks {
    margin-top: 3rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--rule);
  }

  .story__thanks-label {
    font-family: var(--font-body);
    font-size: 0.58rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(15, 13, 12, 0.5);
    display: block;
    margin-bottom: 1rem;
  }

  .story__thanks-text {
    font-size: 0.85rem;
    line-height: 1.95;
    color: var(--ink-soft);
  }

  .story__thanks-text :global(strong) {
    color: var(--ink);
    font-weight: 500;
  }
</style>
