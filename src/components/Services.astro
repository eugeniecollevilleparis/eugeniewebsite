---
import { content } from "../data/content.js";
const lang = Astro.props.lang ?? "en";
const t = content[lang].services;
---

<section class="services section section--dark" id="services">
  <div class="container">
    <header class="services__head">
      <span class="eyebrow" data-reveal>{t.tag}</span>
      <h2 class="display display-2 services__title" data-reveal style="--reveal-delay:0.1s">
        {t.title} <em>{t.titleEm}</em>
      </h2>
      <div class="services__rule" data-reveal style="--reveal-delay:0.15s"></div>
      <p class="services__intro" data-reveal style="--reveal-delay:0.2s">{t.intro}</p>
    </header>

    <ol class="services__list">
      {t.items.map((svc, i) => (
        <li class="svc" data-reveal style={`--reveal-delay:${0.1 + i * 0.06}s`}>
          <span class="svc__num">{svc.n}</span>
          <div class="svc__body">
            <h3 class="svc__title">{svc.name}</h3>
            <p class="svc__desc">{svc.desc}</p>
          </div>
          <div class="svc__arrow" aria-hidden="true">
            <svg width="32" height="12" viewBox="0 0 32 12" fill="none">
              <path d="M1 6H30M30 6L25 1M30 6L25 11" stroke="currentColor" stroke-width="0.8" />
            </svg>
          </div>
        </li>
      ))}
    </ol>

    <div class="locations" data-reveal>
      {t.locations.map((loc) => <span class="loc">{loc}</span>)}
    </div>
  </div>
</section>

<style>
  .services__head {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    align-items: center;
    text-align: center;
    max-width: 60rem;
    margin: 0 auto clamp(4rem, 8vh, 6rem);
  }

  .services__title {
    color: var(--ink);
    font-weight: 300;
  }

  .services__title em {
    font-style: italic;
    font-weight: 300;
    color: var(--accent);
  }

  .services__rule {
    width: 4rem;
    height: 1px;
    background: var(--accent);
    margin: 1rem 0;
  }

  .services__intro {
    max-width: 50ch;
    font-size: 0.95rem;
    line-height: 1.85;
    color: var(--ink-soft);
  }

  .services__list {
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .svc {
    display: grid;
    grid-template-columns: 5rem 1fr auto;
    gap: clamp(1rem, 3vw, 3rem);
    align-items: center;
    padding: clamp(1.75rem, 3.5vh, 2.5rem) 0;
    border-bottom: 1px solid var(--rule);
    transition: padding 0.5s var(--ease);
    cursor: default;
  }

  .svc:hover {
    padding-left: 1.5rem;
  }

  .svc:hover .svc__arrow {
    transform: translateX(0.5rem);
    opacity: 1;
  }

  .svc:hover .svc__num {
    color: var(--ink);
  }

  .svc__num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--accent);
    letter-spacing: 0.05em;
    transition: color 0.5s var(--ease);
  }

  .svc__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .svc__title {
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.005em;
  }

  .svc__desc {
    max-width: 60ch;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .svc__arrow {
    color: var(--ink);
    opacity: 0.4;
    transition: transform 0.5s var(--ease), opacity 0.5s var(--ease);
  }

  .locations {
    margin-top: clamp(4rem, 8vh, 6rem);
    padding-top: 2.5rem;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 2.5rem;
    text-align: center;
  }

  .loc {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1rem, 1.3vw, 1.3rem);
    color: var(--ink);
    position: relative;
  }

  .loc:not(:last-child)::after {
    content: "·";
    position: absolute;
    right: -1.6rem;
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .svc {
      grid-template-columns: 3rem 1fr;
      padding: 1.5rem 0;
    }

    .svc__arrow {
      display: none;
    }

    .svc:hover {
      padding-left: 0;
    }

    .locations {
      gap: 0.75rem 1.75rem;
    }

    .loc:not(:last-child)::after {
      right: -1.1rem;
    }
  }
</style>
