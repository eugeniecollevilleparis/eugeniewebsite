---
import { content } from "../data/content.js";
const lang = Astro.props.lang ?? "en";
const t = content[lang].services;
---

<section class="services section section--dark" id="services">
  <div class="container">
    <header class="services__head">
      <span class="eyebrow" data-reveal>{t.tag}</span>
      <h2 class="display display-2 services__title" data-reveal style="--reveal-delay:0.1s">
        {t.title} <em>{t.titleEm}</em>
      </h2>
      <div class="services__rule" data-reveal style="--reveal-delay:0.15s"></div>
      <p class="services__intro" data-reveal style="--reveal-delay:0.2s">{t.intro}</p>
    </header>

    <ol class="services__list">
      {t.items.map((svc, i) => (
        <li class="svc-li" data-reveal style={`--reveal-delay:${0.1 + i * 0.06}s`}>
          <a class="svc" href="#portfolio">
            <span class="svc__num">{svc.n}</span>
            <div class="svc__body">
              <h3 class="svc__title">{svc.name}</h3>
              <p class="svc__desc">{svc.desc}</p>
              <span class="svc__cta">
                <span>{t.cta}</span>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M4 10L10 4M10 4H4.5M10 4V9.5" stroke="currentColor" stroke-width="1" />
                </svg>
              </span>
            </div>
            <div class="svc__thumb">
              {svc.thumb ? (
                <img src={svc.thumb} alt={svc.name} loading="lazy" />
              ) : (
                <span class="svc__thumb-empty" aria-hidden="true"></span>
              )}
            </div>
          </a>
        </li>
      ))}
    </ol>

    <div class="locations" data-reveal>
      {t.locations.map((loc) => <span class="loc">{loc}</span>)}
    </div>
  </div>
</section>

<style>
  .services__head {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    align-items: center;
    text-align: center;
    max-width: 60rem;
    margin: 0 auto clamp(4rem, 8vh, 6rem);
  }

  .services__title {
    color: var(--ink);
    font-weight: 300;
  }

  .services__title em {
    font-style: italic;
    font-weight: 300;
    color: var(--accent);
  }

  .services__rule {
    width: 4rem;
    height: 1px;
    background: var(--accent);
    margin: 1rem 0;
  }

  .services__intro {
    max-width: 50ch;
    font-size: 0.95rem;
    line-height: 1.85;
  }

  .services__list {
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .svc-li {
    border-bottom: 1px solid var(--rule);
  }

  /* === Service row (clickable link) === */
  .svc {
    display: grid;
    grid-template-columns: 4rem 1fr 96px;
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: center;
    padding: clamp(1.5rem, 3vh, 2.25rem) 0.5rem;
    color: var(--ink);
    transition:
      background 0.4s var(--ease),
      padding 0.5s var(--ease);
  }

  .svc:hover {
    background: rgba(0, 0, 0, 0.025);
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  .svc__num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--accent);
    letter-spacing: 0.05em;
    line-height: 1;
    text-align: center;
  }

  .svc__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .svc__title {
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.005em;
  }

  .svc__desc {
    max-width: 60ch;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .svc__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 0.25rem;
    opacity: 0.7;
    transition: gap 0.4s var(--ease), opacity 0.4s var(--ease), color 0.4s var(--ease);
  }

  .svc:hover .svc__cta {
    gap: 0.7rem;
    opacity: 1;
    color: var(--ink);
  }

  /* === Thumbnail === */
  .svc__thumb {
    width: 96px;
    height: 96px;
    overflow: hidden;
    position: relative;
    background: var(--paper-deep);
    border: 1px solid var(--rule-soft);
    justify-self: end;
  }

  .svc__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(30%);
    transition: transform 0.7s var(--ease-out), filter 0.5s var(--ease);
  }

  .svc:hover .svc__thumb img {
    transform: scale(1.06);
    filter: grayscale(0%);
  }

  .svc__thumb-empty {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, var(--paper) 0%, var(--paper-deep) 100%);
  }

  .svc__thumb-empty::after {
    content: "—";
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(15, 13, 12, 0.18);
    font-family: var(--font-display);
    font-size: 1.4rem;
  }

  /* === Locations === */
  .locations {
    margin-top: clamp(4rem, 8vh, 6rem);
    padding-top: 2.5rem;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 2.5rem;
    text-align: center;
  }

  .loc {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1rem, 1.3vw, 1.3rem);
    color: var(--ink);
    position: relative;
  }

  .loc:not(:last-child)::after {
    content: "·";
    position: absolute;
    right: -1.6rem;
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .svc {
      grid-template-columns: 2.5rem 1fr 70px;
      gap: 1rem;
      padding: 1.25rem 0;
    }

    .svc:hover {
      padding-left: 0;
      padding-right: 0;
      background: transparent;
    }

    .svc__thumb {
      width: 70px;
      height: 70px;
    }

    .locations {
      gap: 0.75rem 1.75rem;
    }

    .loc:not(:last-child)::after {
      right: -1.1rem;
    }
  }
</style>
