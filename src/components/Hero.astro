---
import { content } from "../data/content.js";
const lang = Astro.props.lang ?? "en";
const t = content[lang].hero;
---

<section class="hero" id="top">
  <div class="hero__media">
    <img
      src="/images/hero.jpg"
      alt="Eugénie Colleville — seared scallop with caviar"
      class="hero__photo"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__overlay"></div>
    <div class="hero__vignette"></div>
  </div>

  <div class="hero__content">
    <span class="hero__eyebrow eyebrow" data-reveal style="--reveal-delay:0.1s">{t.eyebrow}</span>

    <div class="hero__brand" data-reveal style="--reveal-delay:0.18s">
      <img src={t.logo} alt={t.logoAlt} loading="eager" />
    </div>

    <h1 class="hero__title display display-1" data-reveal style="--reveal-delay:0.28s">
      {t.title}
      <em class="hero__title-em">{t.titleEm}</em>
    </h1>

    <p class="hero__sub" data-reveal style="--reveal-delay:0.5s">
      <span class="hero__sub-line"></span>
      {t.sub}
    </p>

    <div class="hero__cta-row" data-reveal style="--reveal-delay:0.7s">
      <a href="#contact" class="btn btn--invert">{t.cta}</a>
      <a href={t.instagramUrl} target="_blank" rel="noopener" class="hero__ig">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"></circle>
        </svg>
        <span>{t.instagram}</span>
      </a>
    </div>
  </div>

  <div class="hero__scroll" data-reveal style="--reveal-delay:1.2s">
    <span>{t.scroll}</span>
    <span class="hero__scroll-line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 78vh;
    min-height: 78svh;
    display: flex;
    align-items: flex-end;
    color: var(--ink);
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 65%;
    /* Subtle Ken Burns zoom on page load */
    animation: heroKenBurns 14s var(--ease-out) forwards;
  }

  @keyframes heroKenBurns {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1);
    }
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    /* Soft cream wash so the centered text breathes over the photo */
    background:
      linear-gradient(180deg, rgba(244, 241, 236, 0.4) 0%, rgba(244, 241, 236, 0.0) 35%, rgba(244, 241, 236, 0.0) 65%, rgba(244, 241, 236, 0.35) 100%);
    pointer-events: none;
  }

  .hero__vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 35%, rgba(0, 0, 0, 0.14) 100%);
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    padding: clamp(8rem, 14vh, 11rem) var(--gutter) clamp(3rem, 6vh, 5rem);
    max-width: 1600px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
  }

  .hero__eyebrow {
    color: var(--ink-soft);
  }

  /* No dash before the hero eyebrow — looks cleaner centered */
  .hero__eyebrow::before {
    display: none;
  }

  .hero__brand {
    width: clamp(220px, 28vw, 420px);
    margin-top: 0.5rem;
  }

  .hero__brand img {
    width: 100%;
    height: auto;
  }

  .hero__title {
    max-width: 18ch;
    color: var(--ink);
    font-style: normal;
    font-weight: 300;
    margin-top: 0.5rem;
    text-shadow: 0 1px 24px rgba(255, 255, 255, 0.45);
  }

  .hero__title-em {
    font-style: italic;
    font-weight: 300;
    opacity: 0.95;
    margin-left: 0.2em;
  }

  .hero__sub {
    font-family: var(--font-body);
    color: var(--ink-soft);
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .hero__sub-line {
    width: 2.5rem;
    height: 1px;
    background: var(--ink-soft);
    opacity: 0.5;
  }

  .hero__cta-row {
    margin-top: 1.25rem;
    display: flex;
    gap: 2rem;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero__cta-row .btn--invert {
    border-color: var(--ink);
    color: var(--ink);
  }

  .hero__cta-row .btn--invert:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .hero__ig {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-body);
    font-size: 0.68rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--ink-soft);
    transition: color var(--dur-fast);
  }

  .hero__ig:hover {
    color: var(--ink);
  }

  .hero__scroll {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(2rem, 5vh, 4rem);
    z-index: 2;
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--ink-soft);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    writing-mode: vertical-rl;
  }

  .hero__scroll-line {
    width: 1px;
    height: 3rem;
    background: var(--ink-soft);
    opacity: 0.5;
    position: relative;
    overflow: hidden;
  }

  .hero__scroll-line::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform: translateY(-100%);
    animation: scrollHint 2.4s var(--ease-out) infinite;
  }

  @keyframes scrollHint {
    0% {
      transform: translateY(-100%);
    }
    50% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(100%);
    }
  }

  @media (max-width: 768px) {
    .hero__title {
      max-width: 14ch;
    }
    .hero__scroll {
      display: none;
    }
    .hero__brand {
      width: 70vw;
      max-width: 240px;
    }
  }
</style>
