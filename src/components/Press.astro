---
import { content } from "../data/content.js";
const lang = Astro.props.lang ?? "en";
const t = content[lang].press;
---

<section class="press section" id="press">
  <div class="container">
    <header class="press__head">
      <span class="eyebrow" data-reveal>{t.tag}</span>
      <h2 class="display display-2 press__title" data-reveal style="--reveal-delay:0.1s">{t.title}</h2>
      <div class="press__rule" data-reveal style="--reveal-delay:0.15s"></div>
    </header>

    <ol class="press__list">
      {t.items.map((item, i) => (
        <li class="press-row" data-reveal style={`--reveal-delay:${0.1 + i * 0.08}s`}>
          <span class="press-row__num">0{i + 1}</span>
          <div class="press-row__body">
            <h3 class="press-row__pub">{item.pub}</h3>
            <blockquote class="press-row__quote">
              <span class="press-row__mark">"</span>{item.text}<span class="press-row__mark">"</span>
            </blockquote>
          </div>
          <a
            href={item.url}
            target="_blank"
            rel="noopener"
            class="press-row__link"
            aria-label={`Read the ${item.pub} article`}
          >
            <span>Read</span>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M4 10L10 4M10 4H4.5M10 4V9.5" stroke="currentColor" stroke-width="1" />
            </svg>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .press {
    background: var(--paper);
  }

  .press__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.2rem;
    margin-bottom: clamp(3rem, 6vh, 4.5rem);
  }

  .press__title {
    font-style: italic;
    font-weight: 300;
  }

  .press__rule {
    width: 4rem;
    height: 1px;
    background: var(--accent);
    margin: 0.75rem 0;
  }

  .press__list {
    list-style: none;
    border-top: 1px solid var(--rule);
    max-width: 1100px;
    margin: 0 auto;
  }

  .press-row {
    display: grid;
    grid-template-columns: 5rem 1fr auto;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
    padding: clamp(2rem, 4vh, 2.75rem) 0;
    border-bottom: 1px solid var(--rule);
    transition: padding 0.5s var(--ease);
  }

  .press-row:hover {
    padding-left: 0.75rem;
  }

  .press-row:hover .press-row__link {
    gap: 0.85rem;
    opacity: 1;
  }

  .press-row__num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.5rem;
    color: var(--accent);
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .press-row__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .press-row__pub {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.4rem, 2vw, 1.9rem);
    font-style: italic;
    line-height: 1.1;
    letter-spacing: -0.005em;
  }

  .press-row__quote {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(0.95rem, 1.1vw, 1.1rem);
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 65ch;
    margin: 0;
  }

  .press-row__mark {
    color: var(--accent);
    font-size: 1.05em;
  }

  .press-row__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink);
    opacity: 0.65;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid currentColor;
    align-self: center;
    transition: gap 0.4s var(--ease), opacity 0.4s var(--ease);
  }

  @media (max-width: 768px) {
    .press-row {
      grid-template-columns: 3rem 1fr;
      grid-template-rows: auto auto;
      gap: 0.85rem 1.25rem;
      padding: 1.5rem 0;
    }

    .press-row__link {
      grid-column: 2;
      align-self: start;
      justify-self: start;
    }

    .press-row:hover {
      padding-left: 0;
    }
  }
</style>
