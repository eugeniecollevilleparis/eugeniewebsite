---
import { content } from "../data/content.js";
const lang = Astro.props.lang ?? "en";
const t = content[lang].press;

const logoFor = {
  "Vogue UK": "/images/vogue.png",
  "Hello Magazine": "/images/hello-magazine.png",
  Foodism: "/images/foodism.png",
};
---

<section class="press section" id="press">
  <div class="container">
    <header class="press__head">
      <span class="eyebrow" data-reveal>{t.tag}</span>
      <h2 class="display display-2 press__title" data-reveal style="--reveal-delay:0.1s">{t.title}</h2>
      <div class="press__rule" data-reveal style="--reveal-delay:0.15s"></div>
    </header>

    <div class="press__grid">
      {t.items.map((item, i) => (
        <a href={item.url} target="_blank" rel="noopener" class="press-card" data-reveal style={`--reveal-delay:${0.15 + i * 0.1}s`}>
          <div class="press-card__media" data-reveal-image>
            <div class="press-card__logo-wrap">
              {logoFor[item.pub] && (
                <img src={logoFor[item.pub]} alt={`${item.pub} logo`} loading="lazy" class="press-card__logo" />
              )}
            </div>
          </div>
          <div class="press-card__body">
            <span class="press-card__num">0{i + 1}</span>
            <h3 class="press-card__pub">{item.pub}</h3>
            <p class="press-card__text">{item.text}</p>
            <span class="press-card__link">
              <span>Read</span>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M4 10L10 4M10 4H4.5M10 4V9.5" stroke="currentColor" stroke-width="0.9" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .press {
    background: var(--paper-deep);
  }

  .press__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.2rem;
    margin-bottom: clamp(4rem, 8vh, 6rem);
  }

  .press__title {
    font-style: italic;
    font-weight: 300;
  }

  .press__rule {
    width: 4rem;
    height: 1px;
    background: var(--accent);
    margin: 0.75rem 0;
  }

  .press__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .press-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    color: var(--ink);
  }

  .press-card__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--paper-light);
    border: 1px solid var(--rule-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.5s var(--ease);
  }

  .press-card:hover .press-card__media {
    background: var(--white);
  }

  .press-card__logo-wrap {
    width: 70%;
    height: 35%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .press-card__logo {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
    filter: grayscale(50%);
    opacity: 0.85;
    transition: filter 0.5s var(--ease), opacity 0.5s var(--ease), transform 0.6s var(--ease);
  }

  .press-card:hover .press-card__logo {
    filter: grayscale(0%);
    opacity: 1;
    transform: scale(1.04);
  }

  .press-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .press-card__num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  .press-card__pub {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    line-height: 1.1;
  }

  .press-card__text {
    color: var(--ink-soft);
  }

  .press-card__link {
    margin-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink);
    align-self: flex-start;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--ink);
    transition: gap 0.4s var(--ease);
  }

  .press-card:hover .press-card__link {
    gap: 0.85rem;
  }

  @media (max-width: 900px) {
    .press__grid {
      grid-template-columns: 1fr;
      max-width: 32rem;
      margin: 0 auto;
    }
  }
</style>
