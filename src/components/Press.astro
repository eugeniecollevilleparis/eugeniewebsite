---
import { content } from "../data/content.js";
const lang = Astro.props.lang ?? "en";
const t = content[lang].pressDetail;
---

<section class="press section" id="press">
  <div class="container">
    <header class="press__head">
      <span class="eyebrow" data-reveal>{t.eyebrow}</span>
      <h2 class="display display-2 press__title" data-reveal style="--reveal-delay:0.1s">{t.title}</h2>
    </header>

    <div class="press__grid">
      {t.items.map((item, i) => (
        <article class="press-card" data-reveal style={`--reveal-delay:${0.1 + i * 0.1}s`}>
          <div class="press-card__media" data-reveal-image>
            <div class="placeholder" data-label={`Press · ${item.pub}`}></div>
          </div>
          <div class="press-card__body">
            <span class="press-card__num">0{i + 1}</span>
            <h3 class="press-card__pub display display-3">{item.pub}</h3>
            <p class="press-card__text">{item.text}</p>
            {item.url && (
              <a href={item.url} target="_blank" rel="noopener" class="press-card__link">
                <span>Read</span>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <path d="M4 10L10 4M10 4H4.5M10 4V9.5" stroke="currentColor" stroke-width="0.9" />
                </svg>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .press {
    background: var(--paper);
  }

  .press__head {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: clamp(4rem, 8vh, 6rem);
  }

  .press__title {
    font-style: italic;
    font-weight: 300;
  }

  .press__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .press-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .press-card__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .press-card__media .placeholder {
    width: 100%;
    height: 100%;
  }

  .press-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .press-card__num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  .press-card__pub {
    font-style: normal;
    font-weight: 400;
    line-height: 1.1;
  }

  .press-card__text {
    color: var(--ink-soft);
  }

  .press-card__link {
    margin-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink);
    align-self: flex-start;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--ink);
    transition: gap 0.4s var(--ease);
  }

  .press-card__link:hover {
    gap: 0.85rem;
  }

  @media (max-width: 900px) {
    .press__grid {
      grid-template-columns: 1fr;
      max-width: 32rem;
    }
  }
</style>
