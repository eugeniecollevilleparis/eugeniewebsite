---
import { content } from "../data/content.js";
const lang = Astro.props.lang ?? "en";
const t = content[lang].press;
---

<section class="press section" id="press">
  <div class="container">
    <header class="press__head">
      <span class="eyebrow" data-reveal>{t.tag}</span>
      <h2 class="display display-2 press__title" data-reveal style="--reveal-delay:0.1s">{t.title}</h2>
      <div class="press__rule" data-reveal style="--reveal-delay:0.15s"></div>
    </header>

    <ol class="press__list">
      {t.items.map((item, i) => (
        <li class="press-row" data-reveal style={`--reveal-delay:${0.1 + i * 0.08}s`}>
          <span class="press-row__num">0{i + 1}</span>
          <div class="press-row__body">
            <h3 class="press-row__pub">{item.pub}</h3>
            <blockquote class="press-row__quote">
              <span class="press-row__mark">"</span>{item.text}<span class="press-row__mark">"</span>
            </blockquote>
          </div>
          <a
            href={item.url}
            target="_blank"
            rel="noopener"
            class="press-row__link"
            aria-label={`Read the ${item.pub} article`}
          >
            <span>Read</span>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M4 10L10 4M10 4H4.5M10 4V9.5" stroke="currentColor" stroke-width="1" />
            </svg>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .press {
    background: var(--paper);
  }

  .press__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.2rem;
    margin-bottom: clamp(3rem, 6vh, 4.5rem);
  }

  .press__title {
    font-style: italic;
    font-weight: 300;
  }

  .press__rule {
    width: 4rem;
    height: 1px;
    background: var(--accent);
    margin: 0.75rem 0;
  }

  .press__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    max-width: 1200px;
    margin: 0 auto;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .press-row {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.6rem 1.2rem;
    text-align: center;
    align-items: center;
    position: relative;
  }

  .press-row + .press-row {
    border-left: 1px solid var(--rule);
  }

  @media (max-width: 768px) {
    .press__list {
      grid-template-columns: 1fr;
    }
    .press-row + .press-row {
      border-left: none;
      border-top: 1px solid var(--rule);
    }
  }

  .press-row:hover .press-row__link {
    gap: 0.85rem;
    opacity: 1;
  }

  .press-row__num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--accent);
    letter-spacing: 0.18em;
    line-height: 1;
    opacity: 0.8;
  }

  .press-row__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
  }

  .press-row__pub {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .press-row__quote {
    font-family: var(--font-body);
    font-weight: 300;
    font-style: normal;
    font-size: 0.78rem;
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 32ch;
    margin: 0;
  }

  .press-row__mark {
    color: var(--accent);
  }

  .press-row__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.55rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink);
    opacity: 0.6;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid currentColor;
    transition: gap 0.4s var(--ease), opacity 0.4s var(--ease);
  }

  .press-row__link svg {
    width: 11px;
    height: 11px;
  }
</style>
