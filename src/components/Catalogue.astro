---
import { content } from "../data/content.js";
const lang = Astro.props.lang ?? "en";
const t = content[lang].catalogue;
---

<section class="catalogue section" id="catalogue">
  <div class="container">
    <header class="catalogue__head">
      <span class="eyebrow" data-reveal>{t.tag}</span>
      <h2 class="display display-2 catalogue__title" data-reveal style="--reveal-delay:0.1s">
        {t.title} <em>{t.titleEm}</em>
      </h2>
      <div class="catalogue__rule" data-reveal style="--reveal-delay:0.15s"></div>
      <p class="catalogue__intro" data-reveal style="--reveal-delay:0.2s">{t.intro}</p>
    </header>

    <div class="catalogue__menu">
      {t.courses.map((course, ci) => (
        <div class="course" data-reveal style={`--reveal-delay:${0.1 + ci * 0.15}s`}>
          <header class="course__head">
            <span class="course__label">{course.label}</span>
            <h3 class="course__title display display-3">{course.title}</h3>
            <p class="course__subtitle">{course.subtitle}</p>
          </header>

          <ol class="course__items">
            {course.items.map((item, ii) => (
              <li class="dish" data-reveal style={`--reveal-delay:${0.15 + ii * 0.05}s`}>
                <span class="dish__num">{item.i}</span>
                <div class="dish__body">
                  <span class="dish__place">{item.place}</span>
                  <h4 class="dish__name">{item.name}</h4>
                  <p class="dish__desc">{item.desc}</p>
                </div>
                {item.tag && <span class="dish__tag">{item.tag}</span>}
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>

    <div class="pricing" data-reveal>
      <div class="pricing__inner">
        <div class="pricing__head">
          <span class="pricing__label">{t.pricing.label}</span>
          <span class="pricing__from">{t.pricing.from}</span>
        </div>
        <p class="pricing__note">{t.pricing.note}</p>
        <a href={t.cta.href} class="btn btn--solid pricing__cta">{t.cta.label}</a>
      </div>
    </div>

    <aside class="other-menus" data-reveal>
      <span class="other-menus__label">{t.otherMenusLabel}</span>
      <ul class="other-menus__list">
        {t.otherMenus.map((m) => <li>{m}</li>)}
      </ul>
    </aside>
  </div>
</section>

<style>
  .catalogue {
    background: var(--paper-light);
  }

  .catalogue__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.2rem;
    margin-bottom: clamp(3.5rem, 7vh, 5rem);
  }

  .catalogue__title {
    font-weight: 300;
  }

  .catalogue__title em {
    font-style: italic;
    font-weight: 300;
  }

  .catalogue__rule {
    width: 4rem;
    height: 1px;
    background: var(--accent);
    margin: 0.75rem 0;
  }

  .catalogue__intro {
    max-width: 56ch;
    font-size: 0.95rem;
    line-height: 1.85;
    color: var(--ink-soft);
  }

  /* === Course === */
  .catalogue__menu {
    max-width: 920px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 6vh, 4.5rem);
  }

  .course__head {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 2rem;
  }

  .course__label {
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .course__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    line-height: 1.1;
  }

  .course__subtitle {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 48ch;
  }

  .course__items {
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  /* === Dish === */
  .dish {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    gap: 1.25rem;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px dashed var(--rule);
  }

  .dish__num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--accent);
    line-height: 1;
    text-align: center;
  }

  .dish__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .dish__place {
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .dish__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.1rem, 1.4vw, 1.3rem);
    line-height: 1.25;
    color: var(--ink);
  }

  .dish__desc {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 60ch;
  }

  .dish__tag {
    align-self: center;
    font-family: var(--font-body);
    font-size: 0.55rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--rule);
    white-space: nowrap;
  }

  /* === Pricing === */
  .pricing {
    max-width: 920px;
    margin: clamp(3rem, 6vh, 4.5rem) auto 0;
  }

  .pricing__inner {
    background: var(--paper);
    padding: clamp(2rem, 4vw, 3rem);
    border: 1px solid var(--rule-soft);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .pricing__head {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    align-items: center;
  }

  .pricing__label {
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .pricing__from {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    color: var(--ink);
  }

  .pricing__note {
    max-width: 60ch;
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .pricing__cta {
    margin-top: 0.5rem;
  }

  /* === Other menus === */
  .other-menus {
    max-width: 920px;
    margin: clamp(2.5rem, 5vh, 4rem) auto 0;
    padding-top: 2.5rem;
    border-top: 1px solid var(--rule-soft);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }

  .other-menus__label {
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .other-menus__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem 2rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    color: var(--ink);
  }

  .other-menus__list li {
    position: relative;
  }

  .other-menus__list li:not(:last-child)::after {
    content: "·";
    position: absolute;
    right: -1.2rem;
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .dish {
      grid-template-columns: 1.75rem 1fr;
      grid-template-rows: auto auto;
      gap: 0.75rem 1rem;
      padding: 1.25rem 0;
    }

    .dish__tag {
      grid-column: 2;
      justify-self: start;
      align-self: start;
    }

    .other-menus__list {
      flex-direction: column;
      gap: 0.5rem;
    }

    .other-menus__list li:not(:last-child)::after {
      display: none;
    }
  }
</style>
