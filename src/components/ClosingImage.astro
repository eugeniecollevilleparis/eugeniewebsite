---
import { content } from "../data/content.js";
const lang = Astro.props.lang ?? "en";
const isFr = lang === "fr";
const line = isFr ? "À votre table." : "À votre table.";
---

<section class="closing" aria-label="Closing image">
  <div class="closing__media" data-reveal-image>
    <img
      src="/images/closing.jpg"
      alt="Eugénie Colleville — caviar service on brioche"
      loading="lazy"
    />
  </div>
  <div class="closing__inner">
    <span class="closing__line" data-reveal>{line}</span>
  </div>
</section>

<style>
  .closing {
    position: relative;
    height: clamp(75vh, 95vh, 100vh);
    overflow: hidden;
    background: var(--paper-deep);
  }

  .closing__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .closing__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 72%;
    transform: scale(1.06);
    transition: transform 1.8s var(--ease-out);
  }

  .closing__media.is-visible img {
    transform: scale(1);
  }

  .closing__inner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: clamp(2.5rem, 6vh, 5rem);
    pointer-events: none;
  }

  .closing__line {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.7rem, 3vw, 3rem);
    color: var(--paper);
    letter-spacing: -0.01em;
    /* Subtle drop shadow so it reads on the photo without a pill background */
    text-shadow:
      0 1px 18px rgba(0, 0, 0, 0.45),
      0 1px 3px rgba(0, 0, 0, 0.35);
  }

  @media (max-width: 600px) {
    .closing {
      height: 70vh;
    }
  }
</style>
